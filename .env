# Server Configuration
PORT=7000

# MongoDB Configuration 
MONGODB_URI=mongodb://127.0.0.1:27017/socialweb

# Reddit API
REDDIT_USER_AGENT=SocialApp/1.0

# File Storage Paths
USERS_FILE_PATH=users.json
MESSAGES_FILE_PATH=messages.json
POSTS_FILE_PATH=posts.json
FRIEND_REQUESTS_FILE_PATH=friendRequests.json

# Optional: Add security key for future JWT implementation
JWT_SECRET=your_jwt_secret_key_here