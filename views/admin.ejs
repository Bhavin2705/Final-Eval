<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel - Social</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
    <link rel="icon" type="image/png" href="/images/icon.png" />
    <link rel="stylesheet" href="/components/css/responsive.css">
    <link rel="stylesheet" href="/components/css/admin.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                        },
                        secondary: {
                            50: '#fff1f2',
                            100: '#ffe4e6',
                            200: '#fecdd3',
                            300: '#fda4af',
                            400: '#fb7185',
                            500: '#f43f5e',
                            600: '#e11d48',
                            700: '#be123c',
                            800: '#9f1239',
                            900: '#881337',
                        }
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.3s ease-out',
                        'slide-in': 'slideIn 0.3s ease-out',
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'bounce-slow': 'bounce 2s infinite',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0', transform: 'translateY(10px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' }
                        },
                        slideIn: {
                            '0%': { transform: 'translateX(-100%)' },
                            '100%': { transform: 'translateX(0)' }
                        }
                    },
                    boxShadow: {
                        'soft': '0 2px 15px -3px rgba(0, 0, 0, 0.07), 0 10px 20px -2px rgba(0, 0, 0, 0.04)',
                        'glow': '0 0 15px rgba(14, 165, 233, 0.5)',
                    }
                }
            }
        }
    </script>
    <style>
        .gradient-bg {
            background: linear-gradient(135deg, #0ea5e9 0%, #3b82f6 100%);
        }

        .card-hover {
            transition: all 0.3s ease;
        }

        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

        .table-row-hover:hover {
            background-color: rgba(14, 165, 233, 0.05);
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        .animated-gradient {
            background: linear-gradient(-45deg, #0ea5e9, #3b82f6, #f43f5e, #0ea5e9);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
        }

        @keyframes gradient {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }
    </style>
</head>

<body class="bg-gray-50">
    <!-- Header -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-200 shadow-sm">
        <div class="max-w-full mx-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center space-x-32">
                    <a href="/"
                        class="text-2xl font-semibold hover:text-secondary-500 transition-colors ml-8 flex items-center">
                        <span class="text-primary-600">Social</span>
                        <span class="ml-2 text-xs font-bold bg-blue-500 text-white px-2 py-0.5 rounded-md">ADMIN</span>
                    </a>
                </div>

                <div class="flex-1 max-w-md mx-8 hidden md:block relative">
                    <div class="relative">
                        <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400"
                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        <input type="search" id="userSearchInput" placeholder="Search users by name or email..."
                            class="w-full pl-10 pr-4 py-2 bg-gray-100 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
                    </div>
                </div>

                <div class="flex items-center space-x-4">
                    <div id="userProfileSection">
                        <div class="relative">
                            <button id="profileDropdownButton" class="flex items-center space-x-2 focus:outline-none">
                                <div
                                    class="w-10 h-10 rounded-full bg-gradient-to-r from-blue-500 to-blue-600 flex items-center justify-center shadow-md">
                                    <i class="fas fa-user-shield text-white"></i>
                                </div>
                                <div class="text-left">
                                    <div class="font-semibold" id="adminName">Admin</div>
                                    <div class="text-xs text-gray-500">Administrator</div>
                                </div>
                                <svg class="w-4 h-4 text-gray-700" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>

                            <div id="profileDropdown"
                                class="hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 animate-fade-in">
                                <div class="p-2">
                                    <a href="/"
                                        class="flex items-center w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-md">
                                        <i class="fas fa-home mr-2 text-primary-500"></i>
                                        Home
                                    </a>
                                    <hr class="my-1 border-gray-200">
                                    <button id="logoutButton"
                                        class="flex items-center w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50 rounded-md">
                                        <i class="fas fa-sign-out-alt mr-2"></i>
                                        Logout
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Mobile Menu Button -->
    <div class="md:hidden fixed top-4 right-4 z-50">
        <button id="menu-btn" class="menu-btn p-2 bg-white rounded-md shadow-md">
            <div class="w-6 h-1 bg-gray-800 mb-1"></div>
            <div class="w-6 h-1 bg-gray-800 mb-1"></div>
            <div class="w-6 h-1 bg-gray-800"></div>
        </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="mobile-menu hidden fixed inset-0 bg-gray-900 bg-opacity-50 z-40">
        <div class="bg-white w-3/4 h-full p-6 animate-slide-in">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-xl font-bold text-primary-600">Social Admin</h2>
                <button id="close-menu" class="text-gray-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12">
                        </path>
                    </svg>
                </button>
            </div>
            <ul class="space-y-4">
                <li><a href="/" class="flex items-center py-2 text-gray-700 hover:text-primary-500">
                        <i class="fas fa-home mr-2"></i> Home
                    </a></li>
                <li><button id="mobile-logout" class="flex items-center py-2 text-red-600 hover:text-red-700">
                        <i class="fas fa-sign-out-alt mr-2"></i> Logout
                    </button></li>
            </ul>
        </div>
    </div>

    <!-- Main Content -->
    <main class="container mx-auto py-6 pt-24 px-4">
        <!-- Login Section -->
        <div id="loginSection">
            <div class="max-w-md mx-auto bg-white rounded-xl shadow-soft p-8 mt-10 border border-gray-100">
                <div class="text-center mb-8">
                    <div class="inline-block p-3 rounded-full bg-blue-100 text-blue-600 mb-4">
                        <i class="fas fa-user-shield text-3xl"></i>
                    </div>
                    <h2 class="text-2xl font-bold text-gray-800">Admin Login</h2>
                    <p class="text-gray-500 mt-2">Enter your credentials to access the admin dashboard</p>
                </div>
                <form id="loginForm">
                    <div class="mb-4">
                        <label for="email" class="block text-gray-700 mb-2 font-medium">Email</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-user text-gray-400"></i>
                            </div>
                            <input type="email" id="email" name="email" required
                                class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
                        </div>
                    </div>
                    <div class="mb-6">
                        <label for="password" class="block text-gray-700 mb-2 font-medium">Password</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fas fa-lock text-gray-400"></i>
                            </div>
                            <input type="password" id="password" name="password" required
                                class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
                            <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
                                <button id="togglePassword" type="button"
                                    class="text-gray-400 hover:text-gray-600 focus:outline-none">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div id="loginError" class="hidden mb-4 p-3 bg-red-50 text-red-600 text-center rounded-lg">
                        <i class="fas fa-exclamation-circle mr-2"></i>
                        <span id="errorMessage">Invalid credentials. Please try again.</span>
                    </div>
                    <button type="submit"
                        class="w-full bg-gradient-to-r from-blue-500 to-blue-600 text-white py-2 rounded-lg hover:from-blue-600 hover:to-blue-700 transition-all shadow-md hover:shadow-lg transform hover:scale-[1.02] active:scale-[0.98] font-medium">
                        <i class="fas fa-sign-in-alt mr-2"></i> Login
                    </button>
                </form>
            </div>
        </div>

        <!-- Dashboard Section -->
        <div id="dashboardSection" class="hidden">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
                <div>
                    <h1 class="text-2xl font-bold text-gray-800">Admin Dashboard</h1>
                    <p class="text-gray-500">Manage users and moderate content</p>
                </div>
                <div class="flex flex-wrap gap-3">
                    <div class="relative">
                        <select id="roleFilter"
                            class="appearance-none bg-white border border-gray-300 rounded-lg px-4 py-2 pr-8 focus:outline-none focus:ring-2 focus:ring-primary-500 transition-all">
                            <option value="all">All Roles</option>
                            <option value="moderator">Moderators</option>
                            <option value="user">Users</option>
                            <option value="guest">Guests</option>
                        </select>
                        <div
                            class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="relative">
                        <select id="statusFilter"
                            class="appearance-none bg-white border border-gray-300 rounded-lg px-4 py-2 pr-8 focus:outline-none focus:ring-2 focus:ring-primary-500 transition-all">
                            <option value="all">All Status</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                            <option value="banned">Banned</option>
                        </select>
                        <div
                            class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                <div class="bg-white rounded-xl shadow-soft p-6 card-hover border border-gray-100">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm">Total Users</p>
                            <h3 class="text-2xl font-bold text-gray-800" id="totalUserCount">0</h3>
                            <p class="text-xs text-green-500 mt-1"><i class="fas fa-arrow-up mr-1"></i> 8% from last
                                month</p>
                        </div>
                        <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-users text-blue-500 text-xl"></i>
                        </div>
                    </div>
                </div>
                <div class="bg-white rounded-xl shadow-soft p-6 card-hover border border-gray-100">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm">Moderators</p>
                            <h3 class="text-2xl font-bold text-gray-800" id="modCount">0</h3>
                            <p class="text-xs text-gray-500 mt-1">Total moderator accounts</p>
                        </div>
                        <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-user-cog text-purple-500 text-xl"></i>
                        </div>
                    </div>
                </div>
                <div class="bg-white rounded-xl shadow-soft p-6 card-hover border border-gray-100">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm">Regular Users</p>
                            <h3 class="text-2xl font-bold text-gray-800" id="regularUserCount">0</h3>
                            <p class="text-xs text-gray-500 mt-1">Total user accounts</p>
                        </div>
                        <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-user text-gray-500 text-xl"></i>
                        </div>
                    </div>
                </div>
                <div class="bg-white rounded-xl shadow-soft p-6 card-hover border border-gray-100">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm">Banned Users</p>
                            <h3 class="text-2xl font-bold text-gray-800" id="bannedCount">0</h3>
                            <p class="text-xs text-gray-500 mt-1">Restricted accounts</p>
                        </div>
                        <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-ban text-red-500 text-xl"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- User Management Tabs -->
            <div class="bg-white rounded-xl shadow-soft overflow-hidden border border-gray-100 mb-8">
                <div class="border-b border-gray-200">
                    <div class="flex overflow-x-auto">
                        <button id="allUsersTab"
                            class="px-6 py-4 text-primary-600 border-b-2 border-primary-500 font-medium">
                            All Users
                        </button>
                        <button id="moderatorsTab" class="px-6 py-4 text-gray-500 hover:text-gray-700 font-medium">
                            Moderators
                        </button>
                        <button id="usersTab" class="px-6 py-4 text-gray-500 hover:text-gray-700 font-medium">
                            Regular Users
                        </button>
                        <button id="guestsTab" class="px-6 py-4 text-gray-500 hover:text-gray-700 font-medium">
                            Guests
                        </button>
                        <button id="bannedTab" class="px-6 py-4 text-gray-500 hover:text-gray-700 font-medium">
                            Banned
                        </button>
                    </div>
                </div>

                <!-- User Table -->
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Name</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Email</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Role</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Status</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Last Login</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Actions</th>
                            </tr>
                        </thead>
                        <tbody id="userTableBody" class="bg-white divide-y divide-gray-200">
                            <!-- Table rows will be populated by JavaScript -->
                        </tbody>
                    </table>
                </div>
                <div id="noResults" class="hidden p-6 text-center">
                    <div class="inline-block p-3 rounded-full bg-gray-100 text-gray-500 mb-4">
                        <i class="fas fa-search text-2xl"></i>
                    </div>
                    <p class="text-gray-500">No users found matching your search criteria.</p>
                </div>
                <div class="p-4 border-t border-gray-200 flex flex-col sm:flex-row justify-between items-center gap-4">
                    <div class="text-sm text-gray-500">
                        Showing <span id="showingCount" class="font-medium">0</span> of <span id="totalCount"
                            class="font-medium">0</span> users
                    </div>
                    <div class="flex items-center space-x-4">
                        <div class="flex items-center space-x-1">
                            <button id="prevPage"
                                class="px-3 py-1 border border-gray-300 rounded-md disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-50 transition-colors">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <div class="text-sm text-gray-700">Page <span id="currentPageNum">1</span></div>
                            <button id="nextPage"
                                class="px-3 py-1 border border-gray-300 rounded-md disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-50 transition-colors">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                        <select id="pageSizeSelect"
                            class="appearance-none bg-white border border-gray-300 rounded-lg px-3 py-1 pr-8 focus:outline-none focus:ring-2 focus:ring-primary-500 text-sm">
                            <option value="5">5 per page</option>
                            <option value="10">10 per page</option>
                            <option value="20">20 per page</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Edit User Modal -->
    <div id="editUserModal"
        class="hidden fixed inset-0 flex items-center justify-center bg-gray-900 bg-opacity-50 z-50">
        <div class="bg-white p-6 rounded-xl max-w-md w-full shadow-xl">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-xl font-semibold text-gray-800">Edit User</h3>
                <button id="closeEditModal" class="text-gray-500 hover:text-gray-700 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12">
                        </path>
                    </svg>
                </button>
            </div>
            <form id="editUserForm">
                <div class="mb-4">
                    <label for="editName" class="block text-gray-700 mb-2 font-medium">Name</label>
                    <input type="text" id="editName"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
                </div>
                <div class="mb-4">
                    <label for="editEmail" class="block text-gray-700 mb-2 font-medium">Email</label>
                    <input type="email" id="editEmail"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
                </div>
                <div class="mb-4">
                    <label for="editRole" class="block text-gray-700 mb-2 font-medium">Role</label>
                    <select id="editRole"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
                        <option value="moderator">Moderator</option>
                        <option value="user">User</option>
                        <option value="guest">Guest</option>
                    </select>
                </div>
                <div class="mb-6">
                    <label for="editStatus" class="block text-gray-700 mb-2 font-medium">Status</label>
                    <select id="editStatus"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                        <option value="banned">Banned</option>
                    </select>
                </div>
                <div class="flex justify-end space-x-4">
                    <button type="button" id="cancelEdit"
                        class="px-4 py-2 border border-gray-300 rounded-md hover:bg-gray-100 transition-colors">Cancel</button>
                    <button type="submit"
                        class="px-4 py-2 bg-primary-500 text-white rounded-md hover:bg-primary-600 transition-colors">Save
                        Changes</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div id="confirmationModal"
        class="hidden fixed inset-0 flex items-center justify-center bg-gray-900 bg-opacity-50 z-50">
        <div class="bg-white p-6 rounded-xl max-w-md w-full shadow-xl">
            <div class="text-center mb-4">
                <div id="modalIcon" class="inline-block p-3 rounded-full bg-red-100 text-red-500 mb-4">
                    <i class="fas fa-exclamation-triangle text-2xl"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-800" id="modalTitle">Confirm Action</h3>
                <p class="text-gray-600 mt-2" id="modalMessage">Are you sure you want to perform this action?</p>
            </div>
            <div class="flex justify-center space-x-4 mt-6">
                <button id="cancelAction"
                    class="px-4 py-2 border border-gray-300 rounded-md hover:bg-gray-100 transition-colors">Cancel</button>
                <button id="confirmAction"
                    class="px-4 py-2 bg-red-500 text-white rounded-md hover:bg-red-600 transition-colors">Confirm</button>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toastNotification"
        class="hidden fixed bottom-4 right-4 bg-white border border-gray-200 rounded-lg shadow-lg p-4 transform transition-all duration-300 z-50 max-w-sm">
        <div class="flex items-center">
            <div id="toastIcon" class="flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center mr-4">
                <i id="toastIconSymbol" class="fas fa-check text-lg"></i>
            </div>
            <div class="flex-1">
                <h4 id="toastTitle" class="text-sm font-medium text-gray-900">Success</h4>
                <p id="toastMessage" class="text-sm text-gray-500">Action completed successfully.</p>
            </div>
            <button id="closeToast" class="ml-4 text-gray-400 hover:text-gray-500">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/components/js/admin.js"></script>
    <script>
        // DOM Elements
        const authElements = {
            loginSection: document.getElementById('loginSection'),
            dashboardSection: document.getElementById('dashboardSection'),
            loginForm: document.getElementById('loginForm'),
            emailInput: document.getElementById('email'),
            passwordInput: document.getElementById('password'),
            loginError: document.getElementById('loginError'),
            errorMessage: document.getElementById('errorMessage')
        };

        const dashboardElements = {
            userTableBody: document.getElementById('userTableBody'),
            userSearchInput: document.getElementById('userSearchInput'),
            roleFilter: document.getElementById('roleFilter'),
            statusFilter: document.getElementById('statusFilter'),
            noResults: document.getElementById('noResults'),
            totalUserCount: document.getElementById('totalUserCount'),
            modCount: document.getElementById('modCount'),
            regularUserCount: document.getElementById('regularUserCount'),
            bannedCount: document.getElementById('bannedCount'),
            showingCount: document.getElementById('showingCount'),
            totalCount: document.getElementById('totalCount'),
            currentPageNum: document.getElementById('currentPageNum'),
            prevPage: document.getElementById('prevPage'),
            nextPage: document.getElementById('nextPage'),
            pageSizeSelect: document.getElementById('pageSizeSelect'),
            editUserModal: document.getElementById('editUserModal'),
            editUserForm: document.getElementById('editUserForm'),
            editName: document.getElementById('editName'),
            editEmail: document.getElementById('editEmail'),
            editRole: document.getElementById('editRole'),
            editStatus: document.getElementById('editStatus'),
            closeEditModal: document.getElementById('closeEditModal'),
            cancelEdit: document.getElementById('cancelEdit'),
            confirmationModal: document.getElementById('confirmationModal'),
            modalTitle: document.getElementById('modalTitle'),
            modalMessage: document.getElementById('modalMessage'),
            modalIcon: document.getElementById('modalIcon'),
            cancelAction: document.getElementById('cancelAction'),
            confirmAction: document.getElementById('confirmAction'),
            profileDropdownButton: document.getElementById('profileDropdownButton'),
            profileDropdown: document.getElementById('profileDropdown'),
            logoutButton: document.getElementById('logoutButton'),
            menuBtn: document.getElementById('menu-btn'),
            mobileMenu: document.getElementById('mobile-menu'),
            closeMenu: document.getElementById('close-menu'),
            mobileLogout: document.getElementById('mobile-logout'),
            allUsersTab: document.getElementById('allUsersTab'),
            moderatorsTab: document.getElementById('moderatorsTab'),
            usersTab: document.getElementById('usersTab'),
            guestsTab: document.getElementById('guestsTab'),
            bannedTab: document.getElementById('bannedTab'),
            adminName: document.getElementById('adminName'),
            togglePassword: document.getElementById('togglePassword'),
            closeToast: document.getElementById('closeToast'),
            toastNotification: document.getElementById('toastNotification'),
            toastIcon: document.getElementById('toastIcon'),
            toastIconSymbol: document.getElementById('toastIconSymbol'),
            toastTitle: document.getElementById('toastTitle'),
            toastMessage: document.getElementById('toastMessage')
        };

        // State
        let users = [];
        let filteredUsers = [];
        let currentPage = 1;
        let itemsPerPage = 5;
        let activeTab = 'all';
        let loggedInAdminId = null;

        // Clear localStorage
        function clearLocalStorage() {
            localStorage.clear();
        }

        // Format timestamp
        function formatDate(timestamp) {
            if (!timestamp) return 'Never';
            try {
                const date = new Date(timestamp);
                return date.toLocaleString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                    hour: 'numeric',
                    minute: '2-digit',
                    hour12: true
                });
            } catch (err) {
                console.error('Error formatting date:', err);
                return timestamp;
            }
        }

        // Check authentication
        async function checkAuth() {
            if (!authElements.loginSection || !authElements.dashboardSection) {
                console.error('Critical DOM elements missing:', {
                    loginSection: !!authElements.loginSection,
                    dashboardSection: !!authElements.dashboardSection
                });
                return false;
            }

            try {
                const response = await fetch('/api/admin/me', {
                    method: 'GET',
                    credentials: 'include'
                });

                if (response.ok) {
                    const data = await response.json();
                    if (data.user && data.user.role === 'admin' && data.user.email) {
                        loggedInAdminId = data.user.id;
                        dashboardElements.adminName.textContent = data.user.name || 'Admin';
                        authElements.loginSection.classList.add('hidden');
                        authElements.dashboardSection.classList.remove('hidden');
                        await fetchUsers();
                        updateDashboard();
                        return true;
                    }
                }
                authElements.loginSection.classList.remove('hidden');
                authElements.dashboardSection.classList.add('hidden');
                return false;
            } catch (err) {
                console.error('Error checking auth:', err);
                authElements.loginSection.classList.remove('hidden');
                authElements.dashboardSection.classList.add('hidden');
                return false;
            }
        }

        // Fetch users
        // Fetch users
        async function fetchUsers() {
            try {
                const response = await fetch('/api/admin/users', { // Changed from /api/users
                    method: 'GET',
                    credentials: 'include'
                });
                if (response.ok) {
                    const data = await response.json();
                    users = (data.users || []).filter(user => !['admin', 'owner'].includes(user.role));
                    filteredUsers = [...users];
                    console.log('Fetched users:', users);
                } else {
                    const errorData = await response.json();
                    console.error('Failed to fetch users:', response.status, errorData);
                    showToast('Error', errorData.message || 'Failed to fetch users.', 'error');
                }
            } catch (err) {
                console.error('Error fetching users:', err);
                showToast('Error', 'Failed to fetch users.', 'error');
            }
        }

        // Handle login
        async function handleLogin(e) {
            e.preventDefault();
            try {
                const response = await fetch('/api/admin/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        email: authElements.emailInput.value,
                        password: authElements.passwordInput.value
                    }),
                    credentials: 'include'
                });

                const data = await response.json();
                if (response.ok) {
                    await checkAuth();
                    showToast('Login Successful', 'Welcome to the Admin Dashboard', 'success');
                } else {
                    authElements.loginError.classList.remove('hidden');
                    authElements.errorMessage.textContent = data.message || 'Invalid credentials. Please try again.';
                }
            } catch (err) {
                console.error('Login error:', err);
                authElements.loginError.classList.remove('hidden');
                authElements.errorMessage.textContent = 'Login failed. Please try again.';
            }
        }

        // Update dashboard
        function updateDashboard() {
            dashboardElements.totalUserCount.textContent = users.length;
            dashboardElements.modCount.textContent = users.filter(user => user.role === 'moderator').length;
            dashboardElements.regularUserCount.textContent = users.filter(user => user.role === 'user').length;
            dashboardElements.bannedCount.textContent = users.filter(user => user.status === 'banned').length;
            applyFilters();
        }

        // Apply filters
        function applyFilters() {
            const searchTerm = dashboardElements.userSearchInput.value.toLowerCase();
            const roleValue = dashboardElements.roleFilter.value;
            const statusValue = dashboardElements.statusFilter.value;

            filteredUsers = users.filter(user => {
                const matchesSearch =
                    (user.name && user.name.toLowerCase().includes(searchTerm)) ||
                    (user.email && user.email.toLowerCase().includes(searchTerm));

                let matchesRole = true;
                if (activeTab === 'moderators') {
                    matchesRole = user.role === 'moderator';
                } else if (activeTab === 'users') {
                    matchesRole = user.role === 'user';
                } else if (activeTab === 'guests') {
                    matchesRole = user.role === 'guest';
                } else if (activeTab === 'all') {
                    matchesRole = roleValue === 'all' || user.role === roleValue;
                }

                let matchesStatus = true;
                if (activeTab === 'banned') {
                    matchesStatus = user.status === 'banned';
                } else {
                    matchesStatus = statusValue === 'all' || user.status === statusValue;
                }

                return matchesSearch && matchesRole && matchesStatus;
            });

            dashboardElements.totalCount.textContent = filteredUsers.length;
            currentPage = 1;
            dashboardElements.currentPageNum.textContent = currentPage;
            renderTable();
        }

        // Render table
        function renderTable() {
            const start = (currentPage - 1) * itemsPerPage;
            const end = start + itemsPerPage;
            const paginatedUsers = filteredUsers.slice(start, end);

            dashboardElements.userTableBody.innerHTML = '';

            if (paginatedUsers.length === 0) {
                dashboardElements.noResults.classList.remove('hidden');
                dashboardElements.showingCount.textContent = '0';
            } else {
                dashboardElements.noResults.classList.add('hidden');
                dashboardElements.showingCount.textContent = paginatedUsers.length;

                paginatedUsers.forEach(user => {
                    const row = document.createElement('tr');
                    row.className = 'table-row-hover';
                    row.setAttribute('data-id', user.id);

                    let statusClass, statusIcon;
                    if (user.status === 'active') {
                        statusClass = 'bg-green-100 text-green-800';
                        statusIcon = 'fa-check';
                    } else if (user.status === 'inactive') {
                        statusClass = 'bg-gray-100 text-gray-800';
                        statusIcon = 'fa-times';
                    } else {
                        statusClass = 'bg-red-100 text-red-800';
                        statusIcon = 'fa-ban';
                    }

                    let roleClass, roleIcon;
                    if (user.role === 'moderator') {
                        roleClass = 'bg-purple-100 text-purple-800';
                        roleIcon = 'fa-user-cog';
                    } else if (user.role === 'user') {
                        roleClass = 'bg-gray-100 text-gray-800';
                        roleIcon = 'fa-user';
                    } else {
                        roleClass = 'bg-yellow-100 text-yellow-800';
                        roleIcon = 'fa-user-clock';
                    }

                    const guestTooltip = user.role === 'guest' ? 'title="Guest users have no persistent account and cannot be modified"' : '';
                    const emailDisplay = user.role === 'guest' || !user.email || user.email === '-' ? 'N/A' : user.email;
                    const isSelf = user.id == loggedInAdminId;
                    const actionsDisplay = user.role === 'guest' || isSelf ? 'N/A' : `
                        <div class="flex space-x-2">
                            <button class="text-primary-600 hover:text-primary-800 transition-colors edit-user" data-id="${user.id}" title="Edit User">
                                <i class="fas fa-edit"></i>
                            </button>
                            ${user.role === 'moderator' ? `
                                <button class="text-yellow-600 hover:text-yellow-800 transition-colors demote-mod" data-id="${user.id}" title="Demote Moderator">
                                    <i class="fas fa-user-minus"></i>
                                </button>
                            ` : user.role === 'user' ? `
                                <button class="text-yellow-600 hover:text-yellow-800 transition-colors demote-to-guest" data-id="${user.id}" title="Demote to Guest">
                                    <i class="fas fa-user-minus"></i>
                                </button>
                            ` : ''}
                            ${user.status !== 'banned' ? `
                                <button class="text-red-600 hover:text-red-800 transition-colors ban-user" data-id="${user.id}" title="Ban User">
                                    <i class="fas fa-ban"></i>
                                </button>
                            ` : `
                                <button class="text-green-600 hover:text-green-800 transition-colors unban-user" data-id="${user.id}" title="Unban User">
                                    <i class="fas fa-user-check"></i>
                                </button>
                            `}
                            <button class="text-red-600 hover:text-red-800 transition-colors delete-user" data-id="${user.id}" title="Delete User">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    `;

                    row.innerHTML = `
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700" ${guestTooltip}>${user.name || 'Guest'}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" ${guestTooltip}>${emailDisplay}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            <span class="px-2 py-1 inline-flex items-center text-xs leading-5 font-semibold rounded-full ${roleClass}">
                                <i class="fas ${roleIcon} mr-1"></i> ${user.role}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            <span class="px-2 py-1 inline-flex items-center text-xs leading-5 font-semibold rounded-full ${statusClass}">
                                <i class="fas ${statusIcon} mr-1"></i> ${user.status}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${formatDate(user.lastLogin)}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">${actionsDisplay}</td>
                    `;

                    dashboardElements.userTableBody.appendChild(row);
                });

                attachTableEventListeners();
            }

            dashboardElements.prevPage.disabled = currentPage === 1;
            dashboardElements.nextPage.disabled = end >= filteredUsers.length;
        }

        // Attach table event listeners
        function attachTableEventListeners() {
            document.querySelectorAll('.edit-user').forEach(button => {
                button.addEventListener('click', () => openEditModal(button.getAttribute('data-id')));
            });

            document.querySelectorAll('.demote-mod').forEach(button => {
                button.addEventListener('click', () => {
                    showConfirmationModal('Demote Moderator', 'Are you sure you want to demote this moderator to a regular user?', 'warning', () => {
                        demoteUser(button.getAttribute('data-id'), 'moderator');
                    });
                });
            });

            document.querySelectorAll('.demote-to-guest').forEach(button => {
                button.addEventListener('click', () => {
                    showConfirmationModal(
                        'Demote to Guest',
                        'Are you sure you want to demote this user to a guest? This will remove their persistent account details and cannot be undone.',
                        'danger',
                        () => {
                            demoteToGuest(button.getAttribute('data-id'));
                        }
                    );
                });
            });

            document.querySelectorAll('.ban-user').forEach(button => {
                button.addEventListener('click', () => {
                    const userId = button.getAttribute('data-id');
                    if (userId == loggedInAdminId) {
                        showToast('Error', 'You cannot ban your own account.', 'error');
                        return;
                    }
                    showConfirmationModal('Ban User', 'Are you sure you want to ban this user? They will be unable to access their account.', 'danger', () => {
                        banUser(userId);
                    });
                });
            });

            document.querySelectorAll('.unban-user').forEach(button => {
                button.addEventListener('click', () => {
                    const userId = button.getAttribute('data-id');
                    if (userId == loggedInAdminId) {
                        showToast('Error', 'You cannot unban your own account.', 'error');
                        return;
                    }
                    showConfirmationModal('Unban User', 'Are you sure you want to unban this user? They will regain access to their account.', 'info', () => {
                        unbanUser(userId);
                    });
                });
            });

            document.querySelectorAll('.delete-user').forEach(button => {
                button.addEventListener('click', () => {
                    const userId = button.getAttribute('data-id');
                    if (userId == loggedInAdminId) {
                        showToast('Error', 'You cannot delete your own account.', 'error');
                        return;
                    }
                    showConfirmationModal('Delete User', 'Are you sure you want to permanently delete this user?', 'danger', () => {
                        deleteUser(userId);
                    });
                });
            });
        }

        // Open edit modal
        async function openEditModal(userId) {
            const user = users.find(u => u.id == userId);
            try {
                const response = await fetch('/api/admin/me', {
                    method: 'GET',
                    credentials: 'include'
                });
                const data = await response.json();
                const loggedInUser = data.user;
                const isSelf = user && loggedInUser.id == user.id;

                if (user && dashboardElements.editUserModal) {
                    dashboardElements.editName.value = user.name || 'Guest';
                    dashboardElements.editEmail.value = user.role === 'guest' || !user.email || user.email === '-' ? 'N/A' : user.email;
                    dashboardElements.editRole.value = user.role;
                    dashboardElements.editStatus.value = user.status;

                    dashboardElements.editUserForm.dataset.userId = userId;

                    if (!isSelf) {
                        dashboardElements.editName.disabled = true;
                        dashboardElements.editName.classList.add('bg-gray-100', 'cursor-not-allowed');
                        dashboardElements.editEmail.disabled = true;
                        dashboardElements.editEmail.classList.add('bg-gray-100', 'cursor-not-allowed');
                        let note = dashboardElements.editUserModal.querySelector('.edit-restriction-note');
                        if (!note) {
                            note = document.createElement('p');
                            note.className = 'edit-restriction-note text-sm text-gray-500 mb-4';
                            note.textContent = 'Name and email can only be edited by the user themselves.';
                            dashboardElements.editUserForm.insertBefore(note, dashboardElements.editUserForm.firstChild);
                        }
                    } else {
                        dashboardElements.editName.disabled = false;
                        dashboardElements.editName.classList.remove('bg-gray-100', 'cursor-not-allowed');
                        dashboardElements.editEmail.disabled = false;
                        dashboardElements.editEmail.classList.remove('bg-gray-100', 'cursor-not-allowed');
                        const note = dashboardElements.editUserModal.querySelector('.edit-restriction-note');
                        if (note) note.remove();
                    }

                    if (isSelf) {
                        dashboardElements.editRole.disabled = true;
                        dashboardElements.editRole.classList.add('bg-gray-100', 'cursor-not-allowed');
                        let adminNote = dashboardElements.editUserModal.querySelector('.admin-restriction-note');
                        if (!adminNote) {
                            adminNote = document.createElement('p');
                            adminNote.className = 'admin-restriction-note text-sm text-gray-500 mb-4';
                            adminNote.textContent = 'Admin role cannot be changed for security reasons.';
                            dashboardElements.editUserForm.insertBefore(adminNote, dashboardElements.editUserForm.firstChild);
                        }
                    } else {
                        dashboardElements.editRole.disabled = false;
                        dashboardElements.editRole.classList.remove('bg-gray-100', 'cursor-not-allowed');
                        const adminNote = dashboardElements.editUserModal.querySelector('.admin-restriction-note');
                        if (adminNote) adminNote.remove();
                    }

                    dashboardElements.editUserModal.classList.remove('hidden');
                } else {
                    throw new Error('User not found or modal unavailable');
                }
            } catch (err) {
                console.error('Error opening edit modal:', err);
                showToast('Error', 'Failed to load edit modal.', 'error');
            }
        }

        // Demote user
        async function demoteUser(userId, fromRole) {
            try {
                const response = await fetch(`/api/users/demote`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: userId, fromRole }),
                    credentials: 'include'
                });

                if (response.ok) {
                    await fetchUsers();
                    showToast('User Demoted', `User has been demoted to a regular user.`, 'success');
                } else {
                    const data = await response.json();
                    console.error('Demote user failed:', response.status, data);
                    showToast('Error', data.message || 'Failed to demote user.', 'error');
                }
            } catch (err) {
                console.error('Error demoting user:', err);
                showToast('Error', 'Failed to demote user.', 'error');
            }
        }

        // Demote to guest
        async function demoteToGuest(userId) {
            try {
                const payload = { id: userId, role: 'guest', email: null, name: null };
                const response = await fetch(`/api/users`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                    credentials: 'include'
                });

                if (response.ok) {
                    await fetchUsers();
                    showToast('User Demoted', 'User has been demoted to a guest.', 'success');
                } else {
                    const data = await response.json();
                    console.error('Demote to guest failed:', response.status, data);
                    showToast('Error', data.message || 'Failed to demote user to guest.', 'error');
                }
            } catch (err) {
                console.error('Error demoting to guest:', err);
                showToast('Error', 'Failed to demote user to guest.', 'error');
            }
        }

        // Ban user
        async function banUser(userId) {
            try {
                const response = await fetch(`/api/users/ban`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: userId }),
                    credentials: 'include'
                });

                if (response.ok) {
                    await fetchUsers();
                    showToast('User Banned', 'User has been banned from the platform.', 'success');
                } else {
                    const data = await response.json();
                    console.error('Ban user failed:', response.status, data);
                    showToast('Error', data.message || 'Failed to ban user.', 'error');
                }
            } catch (err) {
                console.error('Error banning user:', err);
                showToast('Error', 'Failed to ban user.', 'error');
            }
        }

        // Unban user
        async function unbanUser(userId) {
            try {
                const response = await fetch(`/api/users/unban`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: userId }),
                    credentials: 'include'
                });

                if (response.ok) {
                    await fetchUsers();
                    showToast('User Unbanned', 'User has been unbanned and can now access their account.', 'success');
                } else {
                    const data = await response.json();
                    console.error('Unban user failed:', response.status, data);
                    showToast('Error', data.message || 'Failed to unban user.', 'error');
                }
            } catch (err) {
                console.error('Error unbanning user:', err);
                showToast('Error', 'Failed to unban user.', 'error');
            }
        }

        // Delete user
        async function deleteUser(userId) {
            try {
                const response = await fetch(`/api/users`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: userId }),
                    credentials: 'include'
                });

                if (response.ok) {
                    await fetchUsers();
                    showToast('User Deleted', 'User has been permanently deleted.', 'success');
                } else {
                    const data = await response.json();
                    console.error('Delete user failed:', response.status, data);
                    showToast('Error', data.message || 'Failed to delete user.', 'error');
                }
            } catch (err) {
                console.error('Error deleting user:', err);
                showToast('Error', 'Failed to delete user.', 'error');
            }
        }

        // Submit user edit
        async function submitUserEdit(userId) {
            try {
                const payload = { id: userId };
                if (!dashboardElements.editName.disabled && dashboardElements.editName.value) payload.name = dashboardElements.editName.value;
                if (!dashboardElements.editEmail.disabled && dashboardElements.editEmail.value && dashboardElements.editEmail.value !== 'N/A') payload.email = dashboardElements.editEmail.value;
                if (!dashboardElements.editRole.disabled && dashboardElements.editRole.value) payload.role = dashboardElements.editRole.value;
                if (dashboardElements.editStatus.value) payload.status = dashboardElements.editStatus.value;

                if (payload.role === 'guest') {
                    payload.email = null;
                    payload.name = null;
                }

                console.log('Submitting user edit payload:', payload);

                const response = await fetch(`/api/users`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                    credentials: 'include'
                });

                if (response.ok) {
                    await fetchUsers();
                    dashboardElements.editUserModal.classList.add('hidden');
                    showToast(
                        'User Updated',
                        payload.role === 'guest' ? 'User has been demoted to a guest.' : 'User details have been updated successfully.',
                        'success'
                    );
                } else {
                    const data = await response.json();
                    console.error('User edit failed:', response.status, data);
                    showToast('Error', data.message || 'Failed to update user.', 'error');
                }
            } catch (err) {
                console.error('Error updating user:', err);
                showToast('Error', 'Failed to update user.', 'error');
            }
        }

        // Show confirmation modal
        function showConfirmationModal(title, message, type, onConfirm) {
            dashboardElements.modalTitle.textContent = title;
            dashboardElements.modalMessage.textContent = message;

            if (type === 'danger') {
                dashboardElements.modalIcon.className = 'inline-block p-3 rounded-full bg-red-100 text-red-500 mb-4';
                dashboardElements.modalIcon.innerHTML = '<i class="fas fa-exclamation-triangle text-2xl"></i>';
                dashboardElements.confirmAction.className = 'px-4 py-2 bg-red-500 text-white rounded-md hover:bg-red-600 transition-colors';
            } else if (type === 'warning') {
                dashboardElements.modalIcon.className = 'inline-block p-3 rounded-full bg-yellow-100 text-yellow-500 mb-4';
                dashboardElements.modalIcon.innerHTML = '<i class="fas fa-exclamation-circle text-2xl"></i>';
                dashboardElements.confirmAction.className = 'px-4 py-2 bg-yellow-500 text-white rounded-md hover:bg-yellow-600 transition-colors';
            } else {
                dashboardElements.modalIcon.className = 'inline-block p-3 rounded-full bg-blue-100 text-blue-500 mb-4';
                dashboardElements.modalIcon.innerHTML = '<i class="fas fa-info-circle text-2xl"></i>';
                dashboardElements.confirmAction.className = 'px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600 transition-colors';
            }

            dashboardElements.confirmationModal.classList.remove('hidden');
            dashboardElements.confirmAction.onclick = () => {
                onConfirm();
                dashboardElements.confirmationModal.classList.add('hidden');
            };
        }

        // Show toast
        function showToast(title, message, type) {
            dashboardElements.toastTitle.textContent = title;
            dashboardElements.toastMessage.textContent = message;

            if (type === 'success') {
                dashboardElements.toastIcon.className = 'flex-shrink-0 w-10 h-10 rounded-full bg-green-100 flex items-center justify-center mr-4';
                dashboardElements.toastIconSymbol.className = 'fas fa-check text-green-500 text-lg';
            } else if (type === 'error') {
                dashboardElements.toastIcon.className = 'flex-shrink-0 w-10 h-10 rounded-full bg-red-100 flex items-center justify-center mr-4';
                dashboardElements.toastIconSymbol.className = 'fas fa-times text-red-500 text-lg';
            } else if (type === 'warning') {
                dashboardElements.toastIcon.className = 'flex-shrink-0 w-10 h-10 rounded-full bg-yellow-100 flex items-center justify-center mr-4';
                dashboardElements.toastIconSymbol.className = 'fas fa-exclamation text-yellow-500 text-lg';
            } else {
                dashboardElements.toastIcon.className = 'flex-shrink-0 w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center mr-4';
                dashboardElements.toastIconSymbol.className = 'fas fa-info text-blue-500 text-lg';
            }

            dashboardElements.toastNotification.classList.remove('hidden');
            dashboardElements.toastNotification.classList.add('animate-fade-in');
            setTimeout(() => {
                dashboardElements.toastNotification.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => {
                    dashboardElements.toastNotification.classList.add('hidden');
                    dashboardElements.toastNotification.classList.remove('opacity-0', 'translate-y-2');
                }, 300);
            }, 3000);
        }

        // Set active tab
        function setActiveTab(tab) {
            [dashboardElements.allUsersTab, dashboardElements.moderatorsTab, dashboardElements.usersTab, dashboardElements.guestsTab, dashboardElements.bannedTab].forEach(tabEl => {
                if (tabEl) {
                    tabEl.classList.remove('text-primary-600', 'border-b-2', 'border-primary-500');
                    tabEl.classList.add('text-gray-500', 'hover:text-gray-700');
                }
            });

            let activeTabEl;
            if (tab === 'all') activeTabEl = dashboardElements.allUsersTab;
            else if (tab === 'moderators') activeTabEl = dashboardElements.moderatorsTab;
            else if (tab === 'users') activeTabEl = dashboardElements.usersTab;
            else if (tab === 'guests') activeTabEl = dashboardElements.guestsTab;
            else activeTabEl = dashboardElements.bannedTab;

            if (activeTabEl) {
                activeTabEl.classList.remove('text-gray-500', 'hover:text-gray-700');
                activeTabEl.classList.add('text-primary-600', 'border-b-2', 'border-primary-500');
            }

            activeTab = tab;
            applyFilters();
        }

        // Event Listeners
        document.addEventListener('DOMContentLoaded', () => {
            clearLocalStorage();
            checkAuth();

            // Login form
            authElements.loginForm.addEventListener('submit', handleLogin);

            // Toggle password
            dashboardElements.togglePassword.addEventListener('click', () => {
                const type = authElements.passwordInput.type === 'password' ? 'text' : 'password';
                authElements.passwordInput.type = type;
                dashboardElements.togglePassword.innerHTML = type === 'password' ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>';
            });

            // Filters
            dashboardElements.userSearchInput.addEventListener('input', applyFilters);
            dashboardElements.roleFilter.addEventListener('change', applyFilters);
            dashboardElements.statusFilter.addEventListener('change', applyFilters);

            // Pagination
            dashboardElements.prevPage.addEventListener('click', () => {
                if (currentPage > 1) {
                    currentPage--;
                    dashboardElements.currentPageNum.textContent = currentPage;
                    renderTable();
                }
            });

            dashboardElements.nextPage.addEventListener('click', () => {
                if ((currentPage * itemsPerPage) < filteredUsers.length) {
                    currentPage++;
                    dashboardElements.currentPageNum.textContent = currentPage;
                    renderTable();
                }
            });

            dashboardElements.pageSizeSelect.addEventListener('change', () => {
                itemsPerPage = parseInt(dashboardElements.pageSizeSelect.value);
                currentPage = 1;
                dashboardElements.currentPageNum.textContent = currentPage;
                renderTable();
            });

            // Tabs
            dashboardElements.allUsersTab.addEventListener('click', () => setActiveTab('all'));
            dashboardElements.moderatorsTab.addEventListener('click', () => setActiveTab('moderators'));
            dashboardElements.usersTab.addEventListener('click', () => setActiveTab('users'));
            dashboardElements.guestsTab.addEventListener('click', () => setActiveTab('guests'));
            dashboardElements.bannedTab.addEventListener('click', () => setActiveTab('banned'));

            // Edit user
            dashboardElements.editUserForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const userId = dashboardElements.editUserForm.dataset.userId;
                const user = users.find(u => u.id == userId);
                const newRole = dashboardElements.editRole.value;

                if (user && user.role !== 'guest' && newRole === 'guest') {
                    showConfirmationModal(
                        'Demote to Guest',
                        'Are you sure you want to demote this user to a guest? This will remove their persistent account details and cannot be undone.',
                        'danger',
                        async () => {
                            await submitUserEdit(userId);
                        }
                    );
                } else {
                    await submitUserEdit(userId);
                }
            });

            // Close edit modal
            dashboardElements.closeEditModal.addEventListener('click', () => dashboardElements.editUserModal.classList.add('hidden'));
            dashboardElements.cancelEdit.addEventListener('click', () => dashboardElements.editUserModal.classList.add('hidden'));

            // Cancel confirmation
            dashboardElements.cancelAction.addEventListener('click', () => dashboardElements.confirmationModal.classList.add('hidden'));

            // Profile dropdown
            dashboardElements.profileDropdownButton.addEventListener('click', () => {
                dashboardElements.profileDropdown.classList.toggle('hidden');
            });

            document.addEventListener('click', (event) => {
                if (!dashboardElements.profileDropdownButton.contains(event.target) && !dashboardElements.profileDropdown.contains(event.target)) {
                    dashboardElements.profileDropdown.classList.add('hidden');
                }
            });

            // Logout
            dashboardElements.logoutButton.addEventListener('click', async () => {
                try {
                    await fetch('/api/admin/logout', {
                        method: 'POST',
                        credentials: 'include'
                    });
                    await checkAuth();
                } catch (err) {
                    console.error('Logout error:', err);
                    showToast('Error', 'Failed to log out.', 'error');
                }
            });

            dashboardElements.mobileLogout.addEventListener('click', async () => {
                try {
                    await fetch('/api/admin/logout', {
                        method: 'POST',
                        credentials: 'include'
                    });
                    await checkAuth();
                    dashboardElements.mobileMenu.classList.add('hidden');
                } catch (err) {
                    console.error('Logout error:', err);
                    showToast('Error', 'Failed to log out.', 'error');
                }
            });

            // Mobile menu
            dashboardElements.menuBtn.addEventListener('click', () => dashboardElements.mobileMenu.classList.toggle('hidden'));
            dashboardElements.closeMenu.addEventListener('click', () => dashboardElements.mobileMenu.classList.add('hidden'));

            // Close toast
            dashboardElements.closeToast.addEventListener('click', () => {
                dashboardElements.toastNotification.classList.add('hidden');
            });
        });
    </script>
</body>

</html>