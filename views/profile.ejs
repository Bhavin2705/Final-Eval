<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Page</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <script src="/components/js/profile.js"></script>
    <style>
        :root {
            --primary-color: #0070f3;
            --primary-hover: #0060df;
            --background-color: #f9fafb;
            --card-background: #ffffff;
            --text-color: #111827;
            --text-muted: #6b7280;
            --border-color: #e5e7eb;
            --input-background: #ffffff;
            --input-border: #d1d5db;
            --input-focus: #0070f3;
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            --radius: 0.5rem;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans",
                "Helvetica Neue", sans-serif;
            background-color: var(--background-color);
            color: var(--text-color);
            line-height: 1.5;
        }

        .container {
            max-width: 800px;
            width: 100%;
            margin: 0 auto;
            padding: 2rem 1rem;
            position: relative;
        }

        .profile-header {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 2rem;
        }

        .profile-avatar-container {
            position: relative;
            margin-bottom: 1rem;
        }

        .profile-avatar {
            width: 128px;
            height: 128px;
            border-radius: 50%;
            overflow: hidden;
            border: 4px solid var(--card-background);
            box-shadow: var(--shadow-lg);
            position: relative;
        }

        .profile-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .avatar-overlay {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: rgba(0, 0, 0, 0.4);
            border-radius: 50%;
            opacity: 0;
            transition: opacity 0.2s ease;
        }

        .profile-avatar:hover .avatar-overlay {
            opacity: 1;
        }

        .profile-name {
            font-size: 1.875rem;
            font-weight: 700;
            margin-top: 0.5rem;
        }

        .profile-email {
            color: var(--text-muted);
            margin-top: 0.25rem;
        }

        .tabs-container {
            width: 100%;
        }

        .tabs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }

        .tab-button {
            padding: 0.75rem 1rem;
            background-color: var(--background-color);
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .tab-button.active {
            background-color: var(--card-background);
            border-color: var(--primary-color);
            color: var(--primary-color);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .card {
            background-color: var(--card-background);
            border-radius: var(--radius);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }

        .card-header {
            padding: 1.5rem;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .card-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }

        .card-description {
            color: var(--text-muted);
            font-size: 0.875rem;
        }

        .card-content {
            padding: 1.5rem;
        }

        .card-footer {
            padding: 1rem 1.5rem;
            border-top: 1px solid var(--border-color);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            font-size: 0.875rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
        }

        input,
        textarea {
            width: 100%;
            padding: 0.75rem;
            background-color: var(--input-background);
            border: 1px solid var(--input-border);
            border-radius: var(--radius);
            font-size: 1rem;
            transition: border-color 0.2s ease;
        }

        input:focus,
        textarea:focus {
            outline: none;
            border-color: var(--input-focus);
            box-shadow: 0 0 0 2px rgba(0, 112, 243, 0.2);
        }

        input:disabled,
        textarea:disabled {
            background-color: var(--background-color);
            cursor: not-allowed;
        }

        textarea {
            min-height: 120px;
            resize: vertical;
        }

        .password-input-container {
            position: relative;
        }

        .password-toggle {
            position: absolute;
            right: 0;
            top: 0;
            height: 100%;
            padding: 0 0.75rem;
            background: transparent;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            color: var(--text-muted);
        }

        .upload-container {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .upload-button {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background-color: var(--card-background);
            border: 1px solid var(--input-border);
            border-radius: var(--radius);
            font-size: 0.875rem;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .upload-button:hover {
            background-color: var(--background-color);
        }

        .upload-hint {
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        .submit-button {
            width: 100%;
            padding: 0.75rem 1rem;
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: var(--radius);
            font-size: 1rem;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        .submit-button:hover {
            background-color: var(--primary-hover);
        }

        .icon-button {
            width: 2.5rem;
            height: 2.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: transparent;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            color: white;
            transition: background-color 0.2s ease;
        }

        .icon-button:hover {
            background-color: rgba(255, 255, 255, 0.2);
        }

        .card-header .icon-button {
            color: var(--text-muted);
        }

        .card-header .icon-button:hover {
            background-color: var(--background-color);
            color: var(--text-color);
        }

        .back-home-button {
            position: absolute;
            top: 1rem;
            right: -10rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1.25rem;
            background: linear-gradient(45deg, var(--primary-color), var(--primary-hover));
            color: white;
            border: none;
            border-radius: 2rem;
            font-size: 1rem;
            font-weight: 500;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
            box-shadow: var(--shadow-md);
        }

        .back-home-button:hover {
            background: linear-gradient(45deg, var(--primary-hover), var(--primary-color));
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .back-home-button:active {
            transform: translateY(0);
            box-shadow: var(--shadow-sm);
        }

        .requirements-title {
            font-size: 0.875rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
        }

        .requirements-list {
            list-style-type: disc;
            padding-left: 1.5rem;
            color: var(--text-muted);
            font-size: 0.875rem;
        }

        .requirements-list li {
            margin-bottom: 0.25rem;
        }

        @media (max-width: 640px) {
            .container {
                padding: 1rem 0.75rem;
            }

            .profile-avatar {
                width: 96px;
                height: 96px;
            }

            .profile-name {
                font-size: 1.5rem;
            }

            .profile-email {
                font-size: 0.875rem;
            }

            .card-header,
            .card-content,
            .card-footer {
                padding: 1rem;
            }

            .tabs {
                gap: 0.25rem;
            }

            .tab-button {
                padding: 0.5rem 0.75rem;
                font-size: 0.875rem;
            }

            input,
            textarea {
                padding: 0.5rem;
                font-size: 0.875rem;
            }

            .submit-button {
                padding: 0.5rem;
                font-size: 0.875rem;
            }

            .upload-button {
                padding: 0.4rem 0.75rem;
                font-size: 0.75rem;
            }

            .upload-hint {
                font-size: 0.75rem;
            }

            .icon-button {
                width: 2rem;
                height: 2rem;
            }

            .back-home-button {
                padding: 0.5rem 1rem;
                font-size: 0.875rem;
                top: 0.75rem;
                right: 2rem;
            }
        }

        @media (max-width: 480px) {
            .container {
                padding: 0.75rem 0.5rem;
            }

            .profile-avatar {
                width: 80px;
                height: 80px;
            }

            .profile-name {
                font-size: 1.25rem;
            }

            .profile-email {
                font-size: 0.75rem;
            }

            .tabs {
                grid-template-columns: 1fr;
                gap: 0.25rem;
            }

            .tab-button {
                padding: 0.4rem 0.5rem;
                font-size: 0.75rem;
            }

            .card-header,
            .card-content,
            .card-footer {
                padding: 0.75rem;
            }

            .card-title {
                font-size: 1rem;
            }

            .card-description {
                font-size: 0.75rem;
            }

            label {
                font-size: 0.75rem;
            }

            input,
            textarea {
                padding: 0.4rem;
                font-size: 0.75rem;
            }

            textarea {
                min-height: 100px;
            }

            .submit-button {
                padding: 0.4rem;
                font-size: 0.75rem;
            }

            .upload-container {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }

            .upload-button {
                padding: 0.3rem 0.5rem;
                font-size: 0.7rem;
            }

            .upload-hint {
                font-size: 0.7rem;
            }

            .password-toggle {
                padding: 0 0.5rem;
            }

            .icon-button {
                width: 1.75rem;
                height: 1.75rem;
            }

            .back-home-button {
                padding: 0.4rem 0.75rem;
                font-size: 0.75rem;
                top: 0.5rem;
                right: 0.5rem;
            }

            .requirements-title {
                font-size: 0.75rem;
            }

            .requirements-list {
                font-size: 0.7rem;
                padding-left: 1rem;
            }
        }

        @media (max-width: 300px) {
            .container {
                padding: 0.5rem 0.25rem;
            }

            .profile-avatar {
                width: 64px;
                height: 64px;
            }

            .profile-name {
                font-size: 1rem;
            }

            .profile-email {
                font-size: 0.7rem;
            }

            .tabs {
                gap: 0.2rem;
            }

            .tab-button {
                padding: 0.3rem 0.4rem;
                font-size: 0.7rem;
            }

            .card-header,
            .card-content,
            .card-footer {
                padding: 0.5rem;
            }

            .card-title {
                font-size: 0.875rem;
            }

            .card-description {
                font-size: 0.7rem;
            }

            label {
                font-size: 0.7rem;
            }

            input,
            textarea {
                padding: 0.3rem;
                font-size: 0.7rem;
            }

            textarea {
                min-height: 80px;
            }

            .submit-button {
                padding: 0.3rem;
                font-size: 0.7rem;
            }

            .upload-button {
                padding: 0.25rem 0.4rem;
                font-size: 0.65rem;
            }

            .upload-hint {
                font-size: 0.65rem;
            }

            .password-toggle {
                padding: 0 0.4rem;
            }

            .icon-button {
                width: 1.5rem;
                height: 1.5rem;
            }

            .back-home-button {
                padding: 0.3rem 0.5rem;
                font-size: 0.7rem;
                top: 0.25rem;
                right: 0.25rem;
            }

            .requirements-title {
                font-size: 0.7rem;
            }

            .requirements-list {
                font-size: 0.65rem;
                padding-left: 0.75rem;
            }
        }
    </style>
    <script>
        if (!window.ProfileManager) {
            console.log('Creating fallback ProfileManager');
            window.ProfileManager = {
                updateProfilePhoto: function (photoUrl) {
                    if (!photoUrl) return;
                    console.log('Fallback: Updating profile photo:', photoUrl);
                    try {
                        localStorage.setItem('profilePicture', photoUrl);
                        const profileImage = document.getElementById('profile-image');
                        if (profileImage) profileImage.src = photoUrl;
                    } catch (error) {
                        console.error('Error updating profile photo:', error);
                    }
                },
                loadProfilePhoto: function () {
                    console.log('Fallback: Loading profile photo');
                    const storedPhoto = localStorage.getItem('profilePicture');
                    if (storedPhoto) {
                        const profileImage = document.getElementById('profile-image');
                        if (profileImage) profileImage.src = storedPhoto;
                    }
                },
                uploadProfilePhoto: async function (file) {
                    if (!file) {
                        return { success: false, error: 'No file provided' };
                    }

                    try {
                        console.log('Fallback: Uploading profile photo:', file.name);
                        const formData = new FormData();
                        formData.append('profilePhoto', file);

                        const response = await fetch('/api/profile/photo', {
                            method: 'POST',
                            body: formData,
                            credentials: 'include'
                        });

                        if (!response.ok) {
                            const errorData = await response.json().catch(() => ({}));
                            throw new Error(errorData.message || `HTTP ${response.status} ${response.statusText}`);
                        }

                        const data = await response.json();
                        if (data.photoUrl) {
                            this.updateProfilePhoto(data.photoUrl);
                            return {
                                success: true,
                                photoUrl: data.photoUrl
                            };
                        }

                        throw new Error('No photo URL in response');
                    } catch (error) {
                        console.error('Error uploading profile photo:', error);
                        return {
                            success: false,
                            error: error.message
                        };
                    }
                }
            };
        }
    </script>
</head>

<body>
    <div class="container">
        <button class="back-home-button" id="back-home-button">
            <i class="fas fa-home"></i>
            Back to Home
            <i class="fas fa-arrow-right"></i>
        </button>
        <div class="profile-header">
            <div class="profile-avatar-container">
                <div class="profile-avatar">
                    <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128' width='128' height='128'%3E%3Ccircle cx='64' cy='64' r='64' fill='%23ddd'/%3E%3Ccircle cx='64' cy='50' r='24' fill='%23bbb'/%3E%3Cpath d='M32 106c0-22 14-32 32-32s32 10 32 32' fill='%23bbb'/%3E%3C/svg%3E"
                        alt="Profile Picture" id="profile-image">
                    <div class="avatar-overlay">
                        <button class="icon-button" id="upload-profile-picture">
                            <i class="fas fa-camera"></i>
                        </button>
                    </div>
                </div>
            </div>
            <h1 class="profile-name" id="profile-name">
                <%= user ? user.name : 'Guest' %>
            </h1>
            <p class="profile-email" id="profile-email">
                <%= user ? user.email : 'No email provided' %>
            </p>
        </div>

        <div class="tabs-container">
            <div class="tabs">
                <button class="tab-button active" data-tab="profile">Profile Information</button>
                <button class="tab-button" data-tab="security">Security</button>
            </div>

            <div class="tab-content active" id="profile-tab">
                <div class="card">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title">Profile Details</h2>
                            <p class="card-description">Update your profile information</p>
                        </div>
                        <button class="icon-button" id="edit-toggle">
                            <i class="fas fa-edit"></i>
                        </button>
                    </div>
                    <div class="card-content">
                        <form id="profile-form">
                            <div class="form-group">
                                <label for="name">Name</label>
                                <input type="text" id="name" value="<%= user ? user.name : '' %>" disabled>
                            </div>

                            <div class="form-group">
                                <label for="email">Email</label>
                                <input type="email" id="email" value="<%= user ? user.email : '' %>" disabled>
                            </div>

                            <div class="form-group">
                                <label for="bio">Bio</label>
                                <textarea id="bio" placeholder="Tell us about yourself"
                                    disabled><%= user ? user.bio || '' : '' %></textarea>
                            </div>

                            <div class="form-group" id="profile-picture-group" style="display: none;">
                                <label for="profile-picture">Profile Picture</label>
                                <div class="upload-container">
                                    <button type="button" class="upload-button" id="upload-button">
                                        <i class="fas fa-upload"></i>
                                        Upload Image
                                    </button>
                                    <p class="upload-hint">JPG, PNG or GIF. 1MB max.</p>
                                </div>
                            </div>

                            <button type="submit" class="submit-button" id="save-profile-button" style="display: none;">
                                Save Changes
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="tab-content" id="security-tab">
                <div class="card">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title">Change Password</h2>
                            <p class="card-description">Update your password to keep your account secure</p>
                        </div>
                    </div>
                    <div class="card-content">
                        <form id="password-form">
                            <div class="form-group">
                                <label for="current-password">Current Password</label>
                                <div class="password-input-container">
                                    <input type="password" id="current-password"
                                        placeholder="Enter your current password">
                                    <button type="button" class="password-toggle">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="new-password">New Password</label>
                                <div class="password-input-container">
                                    <input type="password" id="new-password" placeholder="Enter your new password">
                                    <button type="button" class="password-toggle">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="confirm-password">Confirm New Password</label>
                                <div class="password-input-container">
                                    <input type="password" id="confirm-password"
                                        placeholder="Confirm your new password">
                                    <button type="button" class="password-toggle">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <button type="submit" class="submit-button">
                                Update Password
                            </button>
                        </form>
                    </div>
                    <div class="card-footer">
                        <h3 class="requirements-title">Password Requirements:</h3>
                        <ul class="requirements-list">
                            <li>Minimum 8 characters long</li>
                            <li>At least one uppercase letter</li>
                            <li>At least one number</li>
                            <li>At least one special character</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", async () => {
            console.log('ProfileManager status:', window.ProfileManager ? 'available' : 'not available');
            initializeProfile();
        });

        async function initializeProfile() {
            const defaultProfileImage = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128' width='128' height='128'%3E%3Ccircle cx='64' cy='64' r='64' fill='%23ddd'/%3E%3Ccircle cx='64' cy='50' r='24' fill='%23bbb'/%3E%3Cpath d='M32 106c0-22 14-32 32-32s32 10 32 32' fill='%23bbb'/%3E%3C/svg%3E";

            const fetchProfileData = async (retries = 2) => {
                try {
                    const response = await fetch('/api/me', {
                        method: 'GET',
                        credentials: 'include'
                    });

                    if (response.ok) {
                        const { user: profileData } = await response.json();

                        const profileImg = document.getElementById('profile-image');
                        profileImg.src = profileData.profilePhoto || localStorage.getItem('profilePicture') || defaultProfileImage;

                        document.getElementById('name').value = profileData.name || 'Guest';
                        document.getElementById('email').value = profileData.email || '';
                        document.getElementById('bio').value = profileData.bio || '';
                        document.getElementById('profile-name').textContent = profileData.name || 'Guest';
                        document.getElementById('profile-email').textContent = profileData.email || 'No email provided';
                    } else {
                        throw new Error('Failed to fetch profile data');
                    }
                } catch (error) {
                    console.warn('Failed to fetch profile data:', error);
                    if (retries > 0) {
                        setTimeout(() => fetchProfileData(retries - 1), 1000);
                    } else {
                        document.getElementById('profile-image').src = localStorage.getItem('profilePicture') || defaultProfileImage;

                        const storedName = localStorage.getItem('profileName');
                        const storedEmail = localStorage.getItem('profileEmail');
                        const storedBio = localStorage.getItem('profileBio');

                        document.getElementById('name').value = storedName || 'Guest';
                        document.getElementById('email').value = storedEmail || '';
                        document.getElementById('bio').value = storedBio || '';
                        document.getElementById('profile-name').textContent = storedName || 'Guest';
                        document.getElementById('profile-email').textContent = storedEmail || 'No email provided';
                    }
                }
            };

            await fetchProfileData();

            const tabButtons = document.querySelectorAll('.tab-button');
            const tabContents = document.querySelectorAll('.tab-content');

            tabButtons.forEach(button => {
                button.addEventListener('click', () => {
                    tabButtons.forEach(btn => btn.classList.remove('active'));
                    tabContents.forEach(content => content.classList.remove('active'));

                    button.classList.add('active');
                    const tabId = button.getAttribute('data-tab');
                    document.getElementById(`${tabId}-tab`).classList.add('active');
                });
            });

            const editToggle = document.getElementById('edit-toggle');
            const nameInput = document.getElementById('name');
            const emailInput = document.getElementById('email');
            const bioInput = document.getElementById('bio');
            const profilePictureGroup = document.getElementById('profile-picture-group');
            const saveProfileButton = document.getElementById('save-profile-button');
            let isEditing = false;

            editToggle.addEventListener('click', () => {
                isEditing = !isEditing;

                editToggle.innerHTML = isEditing ? '<i class="fas fa-save"></i>' : '<i class="fas fa-edit"></i>';
                nameInput.disabled = !isEditing;
                emailInput.disabled = !isEditing;
                bioInput.disabled = !isEditing;
                profilePictureGroup.style.display = isEditing ? 'block' : 'none';
                saveProfileButton.style.display = isEditing ? 'block' : 'none';
            });

            const uploadButton = document.getElementById('upload-button');
            const profileImageButton = document.getElementById('upload-profile-picture');
            const profileImage = document.getElementById('profile-image');

            const handleProfilePictureUpload = async (file) => {
                if (!file) return;

                try {
                    if (file.size > 1024 * 1024) {
                        throw new Error('File size exceeds 1MB limit');
                    }

                    const allowedTypes = ['image/jpeg', 'image/png', 'image/gif'];
                    if (!allowedTypes.includes(file.type)) {
                        throw new Error('Only JPG, PNG, or GIF files are allowed');
                    }

                    const result = await window.ProfileManager.uploadProfilePhoto(file);

                    if (!result.success) {
                        throw new Error(result.error || 'Upload failed');
                    }

                    profileImage.src = result.photoUrl;

                    localStorage.setItem('profilePicture', result.photoUrl);

                    await fetchProfileData();

                    alert('Profile picture updated successfully!');
                } catch (error) {
                    console.error('Error uploading profile picture:', error);
                    alert(`Failed to upload profile picture: ${error.message}`);
                }
            };

            if (uploadButton) {
                uploadButton.addEventListener('click', () => {
                    const fileInput = document.createElement('input');
                    fileInput.type = 'file';
                    fileInput.accept = 'image/*';
                    fileInput.onchange = async (e) => {
                        const file = e.target.files[0];
                        await handleProfilePictureUpload(file);
                    };
                    fileInput.click();
                });
            }

            if (profileImageButton) {
                profileImageButton.addEventListener('click', () => {
                    const fileInput = document.createElement('input');
                    fileInput.type = 'file';
                    fileInput.accept = 'image/*';
                    fileInput.onchange = async (e) => {
                        const file = e.target.files[0];
                        await handleProfilePictureUpload(file);
                    };
                    fileInput.click();
                });
            }

            const backHomeButton = document.getElementById('back-home-button');
            if (backHomeButton) {
                backHomeButton.addEventListener('click', () => {
                    window.location.href = '/';
                });
            }

            const passwordForm = document.getElementById('password-form');
            if (passwordForm) {
                passwordForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                });
            }

            const passwordToggles = document.querySelectorAll('.password-toggle');
            if (passwordToggles) {
                passwordToggles.forEach(toggle => {
                    toggle.addEventListener('click', () => {
                        const input = toggle.previousElementSibling;
                        const icon = toggle.querySelector('i');

                        if (input.type === 'password') {
                            input.type = 'text';
                            icon.classList.remove('fa-eye');
                            icon.classList.add('fa-eye-slash');
                        } else {
                            input.type = 'password';
                            icon.classList.remove('fa-eye-slash');
                            icon.classList.add('fa-eye');
                        }
                    });
                });
            }

            const profileForm = document.getElementById('profile-form');
            if (profileForm) {
                profileForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                });
            }
        }
    </script>
</body>

</html>