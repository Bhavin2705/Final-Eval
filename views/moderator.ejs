        const toastMessage = document.getElementById('toastMessage');
        const closeToast = document.getElementById('closeToast');

        // Tab elements
        const allUsersTab = document.getElementById('allUsersTab');
        const reportedTab = document.getElementById('reportedTab');
        const warnedTab = document.getElementById('warnedTab');

        // Pagination state
        let currentPage = 1;
        let itemsPerPage = 5;
        let filteredUsers = [];
        let activeTab = 'all';

        // Check if moderator is logged in
        function checkAuth() {
            const isLoggedIn = localStorage.getItem('modLoggedIn') === 'true';
            if (isLoggedIn) {
                loginContainer.classList.add('hidden');
                dashboardContainer.classList.remove('hidden');
                updateDashboard();
            } else {
                loginContainer.classList.remove('hidden');
                dashboardContainer.classList.add('hidden');
            }
        }

        // Update dashboard data
        function updateDashboard() {
            const users = getUsers();
            const reports = getReports();
            const warnings = getWarnings();

            // Update counts
            userCount.textContent = users.length;
            activeCount.textContent = users.filter(user => user.status === 'active').length;
            reportCount.textContent = reports.filter(report => report.status === 'pending').length;
            warningCount.textContent = warnings.length;

            // Apply filters and render tables
            applyFilters();
            renderReportsTable();
        }

        // Apply filters and search
        function applyFilters() {
            const users = getUsers();
            const warnings = getWarnings();
            const searchTerm = userSearchInput.value.toLowerCase();
            const statusValue = statusFilter.value;

            filteredUsers = users.filter(user => {
                const matchesSearch =
                    user.name.toLowerCase().includes(searchTerm) ||
                    user.email.toLowerCase().includes(searchTerm) ||
                    user.id.toString().includes(searchTerm);

                let matchesTab = true;
                if (activeTab === 'reported') {
                    matchesTab = user.status === 'reported' || user.reports > 0;
                } else if (activeTab === 'warned') {
                    matchesTab = warnings.some(warning => warning.userId === user.id);
                }

                let matchesStatus = true;
                if (statusValue !== 'all') {
                    matchesStatus = user.status === statusValue;
                }

                return matchesSearch && matchesTab && matchesStatus;
            });

            totalCount.textContent = filteredUsers.length;

            // Reset to first page when filters change
            currentPage = 1;
            currentPageNum.textContent = currentPage;
            renderTable();
        }

        // Render users table with current filters and pagination
        function renderTable() {
            const start = (currentPage - 1) * itemsPerPage;
            const end = start + itemsPerPage;
            const paginatedUsers = filteredUsers.slice(start, end);

            userTableBody.innerHTML = '';

            if (paginatedUsers.length === 0) {
                noResults.classList.remove('hidden');
                showingCount.textContent = '0';
            } else {
                noResults.classList.add('hidden');
                showingCount.textContent = paginatedUsers.length;

                paginatedUsers.forEach(user => {
                    const row = document.createElement('tr');
                    row.className = 'table-row-hover';

                    // Status badge class
                    let statusClass, statusIcon;
                    if (user.status === 'active') {
                        statusClass = 'bg-green-100 text-green-800';
                        statusIcon = 'fa-check';
                    } else if (user.status === 'inactive') {
                        statusClass = 'bg-gray-100 text-gray-800';
                        statusIcon = 'fa-times';
                    } else if (user.status === 'reported') {
                        statusClass = 'bg-yellow-100 text-yellow-800';
                        statusIcon = 'fa-flag';
                    }

                    // Reports badge class
                    let reportsClass = '';
                    if (user.reports > 0) {
                        reportsClass = 'bg-red-100 text-red-800';
                    } else {
                        reportsClass = 'bg-gray-100 text-gray-800';
                    }

                    row.innerHTML = `
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${user.id}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">${user.name}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${user.email}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            <span class="px-2 py-1 inline-flex items-center text-xs leading-5 font-semibold rounded-full ${statusClass}">
                                <i class="fas ${statusIcon} mr-1"></i> ${user.status}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${user.lastActive}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            <span class="px-2 py-1 inline-flex items-center text-xs leading-5 font-semibold rounded-full ${reportsClass}">
                                ${user.reports}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                            <div class="flex space-x-2">
                                <button class="text-primary-600 hover:text-primary-800 transition-colors view-user" data-id="${user.id}" title="View User">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="text-yellow-600 hover:text-yellow-800 transition-colors warn-user" data-id="${user.id}" title="Warn User">
                                    <i class="fas fa-exclamation-triangle"></i>
                                </button>
                                ${user.reports > 0 ? `
                                    <button class="text-red-600 hover:text-red-800 transition-colors view-reports" data-id="${user.id}" title="View Reports">
                                        <i class="fas fa-flag"></i>
                                    </button>
                                ` : ''}
                            </div>
                        </td>
                    `;

                    userTableBody.appendChild(row);
                });

                // Add event listeners to action buttons
                document.querySelectorAll('.view-user').forEach(button => {
                    button.addEventListener('click', function () {
                        const userId = this.getAttribute('data-id');
                        openViewUserModal(userId);
                    });
