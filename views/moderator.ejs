                document.querySelectorAll('.warn-user').forEach(button => {
                    button.addEventListener('click', function () {
                        const userId = this.getAttribute('data-id');
                        openWarningModal(userId);
                    });
                });

                document.querySelectorAll('.view-reports').forEach(button => {
                    button.addEventListener('click', function () {
                        const userId = this.getAttribute('data-id');
                        showUserReports(userId);
                    });
                });
            }

            // Update pagination buttons
            prevPage.disabled = currentPage === 1;
            nextPage.disabled = end >= filteredUsers.length;
        }

        // Render reports table
        function renderReportsTable() {
            const reports = getReports().filter(report => report.status === 'pending');

            reportTableBody.innerHTML = '';

            if (reports.length === 0) {
                noReports.classList.remove('hidden');
            } else {
                noReports.classList.add('hidden');

                reports.forEach(report => {
                    const row = document.createElement('tr');
                    row.className = 'table-row-hover';

                    // Content type badge class
                    let contentClass, contentIcon;
                    if (report.contentType === 'post') {
                        contentClass = 'bg-blue-100 text-blue-800';
                        contentIcon = 'fa-file-alt';
                    } else if (report.contentType === 'comment') {
                        contentClass = 'bg-purple-100 text-purple-800';
                        contentIcon = 'fa-comment';
                    } else if (report.contentType === 'profile') {
                        contentClass = 'bg-green-100 text-green-800';
                        contentIcon = 'fa-user';
                    }

                    // Status badge class
                    let statusClass, statusIcon;
                    if (report.status === 'pending') {
                        statusClass = 'bg-yellow-100 text-yellow-800';
                        statusIcon = 'fa-clock';
                    } else if (report.status === 'resolved') {
                        statusClass = 'bg-green-100 text-green-800';
                        statusIcon = 'fa-check';
                    } else if (report.status === 'ignored') {
                        statusClass = 'bg-gray-100 text-gray-800';
                        statusIcon = 'fa-times';
                    }

                    row.innerHTML = `
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">${report.id}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">${report.userName}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            <span class="px-2 py-1 inline-flex items-center text-xs leading-5 font-semibold rounded-full ${contentClass}">
                                <i class="fas ${contentIcon} mr-1"></i> ${report.contentType}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${report.reason}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${report.date}</td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            <span class="px-2 py-1 inline-flex items-center text-xs leading-5 font-semibold rounded-full ${statusClass}">
                                <i class="fas ${statusIcon} mr-1"></i> ${report.status}
                            </span>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                            <div class="flex space-x-2">
                                <button class="text-primary-600 hover:text-primary-800 transition-colors view-report" data-id="${report.id}" title="View Report">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </td>
                    `;

                    reportTableBody.appendChild(row);
                });

                // Add event listeners to action buttons
                document.querySelectorAll('.view-report').forEach(button => {
                    button.addEventListener('click', function () {
                        const reportId = this.getAttribute('data-id');
                        openViewReportModal(reportId);
                    });
                });
            }
        }

        // Open view user modal
        function openViewUserModal(userId) {
            const users = getUsers();
            const user = users.find(u => u.id.toString() === userId);

            if (user) {
                viewUserId.textContent = user.id;
                viewName.textContent = user.name;
                viewEmail.textContent = user.email;
                viewStatus.textContent = user.status;
                viewReports.textContent = user.reports;
                viewLastActive.textContent = user.lastActive;
                viewCreated.textContent = user.created;

                viewUserModal.classList.remove('hidden');

                // Store user ID for warning button
                warnUserBtn.setAttribute('data-id', user.id);
            }
        }

        // Open view report modal
        function openViewReportModal(reportId) {
            const reports = getReports();
            const report = reports.find(r => r.id.toString() === reportId);

            if (report) {
                viewReportId.textContent = report.id;
                viewReportedUser.textContent = report.userName;
                viewContentType.textContent = report.contentType;
                viewReportedBy.textContent = report.reportedBy;
                viewReason.textContent = report.reason;
                viewReportDate.textContent = report.date;
                viewContent.textContent = report.content;

                viewReportModal.classList.remove('hidden');

                // Store report ID for action buttons
                ignoreReportBtn.setAttribute('data-id', report.id);
                warnReportBtn.setAttribute('data-id', report.userId);
                removeContentBtn.setAttribute('data-id', report.id);
            }
        }

        // Open warning modal
        function openWarningModal(userId) {
            warningUserId.value = userId;
            warningMessage.value = '';
            warningReason.selectedIndex = 0;
            warningModal.classList.remove('hidden');
        }

        // Show user reports
        function showUserReports(userId) {
            const reports = getReports();
            const userReports = reports.filter(r => r.userId.toString() === userId);

            if (userReports.length > 0) {
                // Open the first report
                openViewReportModal(userReports[0].id.toString());
            } else {
                showToast('No Reports', 'This user has no active reports.', 'info');
            }
        }

        // Issue warning to user
        function issueWarning(userId, reason, message) {
            const users = getUsers();
            const warnings = getWarnings();

            const userIndex = users.findIndex(u => u.id.toString() === userId);
            if (userIndex !== -1) {
                // Add warning to warnings list
                warnings.push({
                    id: warnings.length + 1,
                    userId: parseInt(userId),
                    userName: users[userIndex].name,
                    reason: reason,
                    message: message,
                    date: new Date().toISOString().split('T')[0]
                });

                saveWarnings(warnings);

                showToast('Warning Issued', 'Warning has been sent to the user.', 'success');
            }
        }

        // Resolve report
        function resolveReport(reportId, resolution) {
            const reports = getReports();
            const reportIndex = reports.findIndex(r => r.id.toString() === reportId);

            if (reportIndex !== -1) {
                reports[reportIndex].status = resolution;
                reports[reportIndex].resolvedDate = new Date().toISOString().split('T')[0];

                saveReports(reports);

                // Update user's report count if resolved
                if (resolution === 'resolved') {
                    const users = getUsers();
                    const userIndex = users.findIndex(u => u.id === reports[reportIndex].userId);

                    if (userIndex !== -1 && users[userIndex].reports > 0) {
                        users[userIndex].reports--;
                        if (users[userIndex].reports === 0 && users[userIndex].status === 'reported') {
                            users[userIndex].status = 'active';
                        }
                        saveUsers(users);
                    }
                }

                updateDashboard();
                showToast('Report Updated', `Report has been marked as ${resolution}.`, 'success');
            }
        }

        // Remove content
        function removeContent(reportId) {
            const reports = getReports();
            const reportIndex = reports.findIndex(r => r.id.toString() === reportId);

            if (reportIndex !== -1) {
                // Mark report as resolved
                reports[reportIndex].status = 'resolved';
                reports[reportIndex].resolvedDate = new Date().toISOString().split('T')[0];
                reports[reportIndex].resolution = 'content_removed';

                saveReports(reports);

                // Update user's report count
                const users = getUsers();
                const userIndex = users.findIndex(u => u.id === reports[reportIndex].userId);

                if (userIndex !== -1 && users[userIndex].reports > 0) {
                    users[userIndex].reports--;
                    if (users[userIndex].reports === 0 && users[userIndex].status === 'reported') {
                        users[userIndex].status = 'active';
                    }
                    saveUsers(users);
                }

                updateDashboard();
                showToast('Content Removed', 'The reported content has been removed.', 'success');
            }
        }

        // Show confirmation modal
        function showConfirmationModal(title, message, type, onConfirm) {
            modalTitle.textContent = title;
            modalMessage.textContent = message;

            // Set icon based on type
            if (type === 'danger') {
                modalIcon.className = 'inline-block p-3 rounded-full bg-red-100 text-red-500 mb-4';
                modalIcon.innerHTML = '<i class="fas fa-exclamation-triangle text-2xl"></i>';
                confirmAction.className = 'px-4 py-2 bg-red-500 text-white rounded-md hover:bg-red-600 transition-colors';
            } else if (type === 'warning') {
                modalIcon.className = 'inline-block p-3 rounded-full bg-yellow-100 text-yellow-500 mb-4';
                modalIcon.innerHTML = '<i class="fas fa-exclamation-circle text-2xl"></i>';
                confirmAction.className = 'px-4 py-2 bg-yellow-500 text-white rounded-md hover:bg-yellow-600 transition-colors';
            } else {
                modalIcon.className = 'inline-block p-3 rounded-full bg-blue-100 text-blue-500 mb-4';
                modalIcon.innerHTML = '<i class="fas fa-info-circle text-2xl"></i>';
                confirmAction.className = 'px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600 transition-colors';
            }

            confirmationModal.classList.remove('hidden');

            // Store the confirm action
            confirmAction.onclick = () => {
                onConfirm();
                confirmationModal.classList.add('hidden');
            };
        }

        // Show toast notification
        function showToast(title, message, type) {
            toastTitle.textContent = title;
            toastMessage.textContent = message;

            // Set icon and colors based on type
            if (type === 'success') {
                toastIcon.className = 'flex-shrink-0 w-10 h-10 rounded-full bg-green-100 flex items-center justify-center mr-4';
                toastIconSymbol.className = 'fas fa-check text-green-500 text-lg';
            } else if (type === 'error') {
                toastIcon.className = 'flex-shrink-0 w-10 h-10 rounded-full bg-red-100 flex items-center justify-center mr-4';
                toastIconSymbol.className = 'fas fa-times text-red-500 text-lg';
            } else if (type === 'warning') {
                toastIcon.className = 'flex-shrink-0 w-10 h-10 rounded-full bg-yellow-100 flex items-center justify-center mr-4';
                toastIconSymbol.className = 'fas fa-exclamation text-yellow-500 text-lg';
            } else {
                toastIcon.className = 'flex-shrink-0 w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center mr-4';
                toastIconSymbol.className = 'fas fa-info text-blue-500 text-lg';
            }

            // Show toast
            toastNotification.classList.remove('hidden');
            toastNotification.classList.add('animate-fade-in');

            // Auto hide after 3 seconds
            setTimeout(() => {
                toastNotification.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => {
                    toastNotification.classList.add('hidden');
                    toastNotification.classList.remove('opacity-0', 'translate-y-2');
                }, 300);
            }, 3000);
        }

        // Set active tab
        function setActiveTab(tab) {
            // Remove active class from all tabs
            [allUsersTab, reportedTab, warnedTab].forEach(tabEl => {
                tabEl.classList.remove('text-primary-600', 'border-b-2', 'border-primary-500');
                tabEl.classList.add('text-gray-500', 'hover:text-gray-700');
            });

            // Add active class to selected tab
            let activeTabEl;
            if (tab === 'all') {
                activeTabEl = allUsersTab;
            } else if (tab === 'reported') {
                activeTabEl = reportedTab;
            } else if (tab === 'warned') {
                activeTabEl = warnedTab;
            }

            activeTabEl.classList.remove('text-gray-500', 'hover:text-gray-700');
            activeTabEl.classList.add('text-primary-600', 'border-b-2', 'border-primary-500');

            // Update active tab and reapply filters
            activeTab = tab;
            applyFilters();
        }

        // Event Listeners
        document.addEventListener('DOMContentLoaded', () => {
            // Initialize localStorage
            initializeLocalStorage();

            // Check if logged in
            checkAuth();

            // Login form submission
            loginButton.addEventListener('click', () => {
                const id = modIdInput.value;
                const password = modPasswordInput.value;

                if (id === modCredentials.id && password === modCredentials.password) {
                    localStorage.setItem('modLoggedIn', 'true');
                    checkAuth();
                    showToast('Login Successful', 'Welcome to the Moderator Dashboard', 'success');
                } else {
                    loginError.classList.remove('hidden');
                    document.getElementById('errorMessage').textContent = 'Invalid credentials. Please try again.';
                }
            });

            // Toggle password visibility
            togglePassword.addEventListener('click', () => {
                const type = modPasswordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                modPasswordInput.setAttribute('type', type);
                togglePassword.innerHTML = type === 'password' ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>';
            });

            // Search and filter
            userSearchInput.addEventListener('input', applyFilters);
            statusFilter.addEventListener('change', applyFilters);

            // Pagination
            prevPage.addEventListener('click', () => {
                if (currentPage > 1) {
                    currentPage--;
                    currentPageNum.textContent = currentPage;
                    renderTable();
                }
            });

            nextPage.addEventListener('click', () => {
                const maxPage = Math.ceil(filteredUsers.length / itemsPerPage);
                if (currentPage < maxPage) {
                    currentPage++;
                    currentPageNum.textContent = currentPage;
                    renderTable();
                }
            });

            // Page size select
            pageSizeSelect.addEventListener('change', () => {
                itemsPerPage = parseInt(pageSizeSelect.value);
                currentPage = 1;
                currentPageNum.textContent = currentPage;
                renderTable();
            });

            // Tab navigation
            allUsersTab.addEventListener('click', () => setActiveTab('all'));
            reportedTab.addEventListener('click', () => setActiveTab('reported'));
            warnedTab.addEventListener('click', () => setActiveTab('warned'));

            // View user modal
            closeViewModal.addEventListener('click', () => {
                viewUserModal.classList.add('hidden');
            });

            closeViewBtn.addEventListener('click', () => {
                viewUserModal.classList.add('hidden');
            });

            warnUserBtn.addEventListener('click', () => {
                const userId = warnUserBtn.getAttribute('data-id');
                viewUserModal.classList.add('hidden');
                openWarningModal(userId);
            });

            // View report modal
            closeReportModal.addEventListener('click', () => {
                viewReportModal.classList.add('hidden');
            });

            ignoreReportBtn.addEventListener('click', () => {
                const reportId = ignoreReportBtn.getAttribute('data-id');
                showConfirmationModal('Ignore Report', 'Are you sure you want to ignore this report?', 'warning', () => {
                    resolveReport(reportId, 'ignored');
                    viewReportModal.classList.add('hidden');
                });
            });

            warnReportBtn.addEventListener('click', () => {
                const userId = warnReportBtn.getAttribute('data-id');
                viewReportModal.classList.add('hidden');
                openWarningModal(userId);
            });

            removeContentBtn.addEventListener('click', () => {
                const reportId = removeContentBtn.getAttribute('data-id');
                showConfirmationModal('Remove Content', 'Are you sure you want to remove this content? This action cannot be undone.', 'danger', () => {
                    removeContent(reportId);
                    viewReportModal.classList.add('hidden');
                });
            });

            // Warning modal
            warningForm.addEventListener('submit', (e) => {
                e.preventDefault();

                const userId = warningUserId.value;
                const reason = warningReason.value;
                const message = warningMessage.value;

                // if (!message.trim()) {
                //     showToast('Error', 'Please provide a warning message.', 'error');
                //     return;
                // }

                issueWarning(userId, reason, message);
                warningModal.classList.add('hidden');
            });

            cancelWarning.addEventListener('click', () => {
                warningModal.classList.add('hidden');
            });

            // Modal cancel button
            cancelAction.addEventListener('click', () => {
                confirmationModal.classList.add('hidden');
            });

            // Close toast
            closeToast.addEventListener('click', () => {
                toastNotification.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => {
                    toastNotification.classList.add('hidden');
                    toastNotification.classList.remove('opacity-0', 'translate-y-2');
                }, 300);
            });

            // Profile dropdown
            profileDropdownButton.addEventListener('click', () => {
                profileDropdown.classList.toggle('hidden');
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', (event) => {
                if (!profileDropdownButton.contains(event.target) && !profileDropdown.contains(event.target)) {
                    profileDropdown.classList.add('hidden');
                }
            });

            // Logout
            logoutButton.addEventListener('click', () => {
                localStorage.removeItem('modLoggedIn');
                checkAuth();
            });

            // Mobile menu
            menuBtn.addEventListener('click', () => {
                mobileMenu.classList.remove('hidden');
            });

            closeMenu.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });

            mobileLogout.addEventListener('click', () => {
                localStorage.removeItem('modLoggedIn');
                checkAuth();
                mobileMenu.classList.add('hidden');
            });

            // Comment: In a real application, we would fetch data from an API
            // Example API fetch code (commented out as requested):
