<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Moderator Panel - Social</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
    <link rel="icon" type="image/png" href="/images/icon.png" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                        },
                        secondary: {
                            50: '#fff1f2',
                            100: '#ffe4e6',
                            200: '#fecdd3',
                            300: '#fda4af',
                            400: '#fb7185',
                            500: '#f43f5e',
                            600: '#e11d48',
                            700: '#be123c',
                            800: '#9f1239',
                            900: '#881337',
                        }
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.3s ease-out',
                        'slide-in': 'slideIn 0.3s ease-out',
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'bounce-slow': 'bounce 2s infinite',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0', transform: 'translateY(10px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' }
                        },
                        slideIn: {
                            '0%': { transform: 'translateX(-100%)' },
                            '100%': { transform: 'translateX(0)' }
                        }
                    },
                    boxShadow: {
                        'soft': '0 2px 15px -3px rgba(0, 0, 0, 0.07), 0 10px 20px -2px rgba(0, 0, 0, 0.04)',
                        'glow': '0 0 15px rgba(14, 165, 233, 0.5)',
                    }
                }
            }
        }
    </script>
    <style>
        .gradient-bg {
            background: linear-gradient(135deg, #0ea5e9 0%, #3b82f6 100%);
        }

        .card-hover {
            transition: all 0.3s ease;
        }

        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }

        .table-row-hover:hover {
            background-color: rgba(14, 165, 233, 0.05);
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* Animated background */
        .animated-gradient {
            background: linear-gradient(-45deg, #0ea5e9, #3b82f6, #f43f5e, #0ea5e9);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
        }

        @keyframes gradient {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }
    </style>
</head>

<body class="bg-gray-50">
    <!-- Header -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-200 shadow-sm">
        <div class="max-w-full mx-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center space-x-32">
                    <a href="/"
                        class="text-2xl font-semibold hover:text-secondary-500 transition-colors ml-8 flex items-center">
                        <span class="text-primary-600">Social</span>
                        <span
                            class="ml-2 text-xs font-bold bg-green-500 text-white px-2 py-0.5 rounded-md">MODERATOR</span>
                    </a>
                </div>

                <div class="flex-1 max-w-md mx-8 hidden md:block relative">
                    <div class="relative">
                        <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400"
                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        <input type="search" id="userSearchInput"
                            placeholder="Search users by name, email, or status..."
                            class="w-full pl-10 pr-4 py-2 bg-gray-100 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
                    </div>
                </div>

                <div class="flex items-center space-x-4">
                    <div id="userProfileSection">
                        <div class="relative">
                            <button id="profileDropdownButton" class="flex items-center space-x-2 focus:outline-none">
                                <div
                                    class="w-10 h-10 rounded-full bg-gradient-to-r from-green-500 to-green-600 flex items-center justify-center shadow-md">
                                    <i class="fas fa-user-shield text-white"></i>
                                </div>
                                <div class="text-left">
                                    <div class="font-semibold" id="modName">Moderator</div>
                                    <div class="text-xs text-gray-500">Moderator</div>
                                </div>
                                <svg class="w-4 h-4 text-gray-700" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>

                            <div id="profileDropdown"
                                class="hidden absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 animate-fade-in">
                                <div class="p-2">
                                    <a href="/"
                                        class="flex items-center w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-md">
                                        <i class="fas fa-home mr-2 text-primary-500"></i>
                                        Home
                                    </a>
                                    <hr class="my-1 border-gray-200">
                                    <button id="logoutButton"
                                        class="flex items-center w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50 rounded-md">
                                        <i class="fas fa-sign-out-alt mr-2"></i>
                                        Logout
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Mobile Menu Button -->
    <div class="md:hidden fixed top-4 right-4 z-50">
        <button id="menu-btn" class="menu-btn p-2 bg-white rounded-md shadow-md">
            <div class="w-6 h-1 bg-gray-800 mb-1"></div>
            <div class="w-6 h-1 bg-gray-800 mb-1"></div>
            <div class="w-6 h-1 bg-gray-800"></div>
        </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="mobile-menu hidden fixed inset-0 bg-gray-900 bg-opacity-50 z-40">
        <div class="bg-white w-3/4 h-full p-6 animate-slide-in">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-xl font-bold text-primary-600">Social Moderator</h2>
                <button id="close-menu" class="text-gray-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12">
                        </path>
                    </svg>
                </button>
            </div>
            <ul class="space-y-4">
                <li><a href="/" class="flex items-center py-2 text-gray-700 hover:text-primary-500">
                        <i class="fas fa-home mr-2"></i> Home
                    </a></li>
                <li><button id="mobile-logout" class="flex items-center py-2 text-red-600 hover:text-red-700">
                        <i class="fas fa-sign-out-alt mr-2"></i> Logout
                    </button></li> 
            </ul>
        </div>
    </div>

    <!-- Main Content -->
    <main class="container mx-auto py-6 pt-24 px-4">
        <!-- Login Form (Initially Shown) -->
        <div id="loginContainer"
            class="max-w-md mx-auto bg-white rounded-xl shadow-soft p-8 mt-10 border border-gray-100">
            <div class="text-center mb-8">
                <div class="inline-block p-3 rounded-full bg-green-100 text-green-600 mb-4">
                    <i class="fas fa-user-shield text-3xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-gray-800">Moderator Login</h2>
                <p class="text-gray-500 mt-2">Enter your credentials to access the moderator dashboard</p>
            </div>
            <div class="mb-4">
                <label for="modId" class="block text-gray-700 mb-2 font-medium">Moderator ID</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fas fa-user text-gray-400"></i>
                    </div>
                    <input type="text" id="modId"
                        class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
                </div>
            </div>
            <div class="mb-6">
                <label for="modPassword" class="block text-gray-700 mb-2 font-medium">Password</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fas fa-lock text-gray-400"></i>
                    </div>
                    <input type="password" id="modPassword"
                        class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-all">
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
                        <button id="togglePassword" type="button"
                            class="text-gray-400 hover:text-gray-600 focus:outline-none">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div id="loginError" class="hidden mb-4 p-3 bg-red-50 text-red-600 text-center rounded-lg">
                <i class="fas fa-exclamation-circle mr-2"></i>
                <span id="errorMessage">Invalid credentials. Please try again.</span>
            </div>
            <button id="loginButton"
                class="w-full bg-gradient-to-r from-green-500 to-green-600 text-white py-2 rounded-lg hover:from-green-600 hover:to-green-700 transition-all shadow-md hover:shadow-lg transform hover:scale-[1.02] active:scale-[0.98] font-medium">
                <i class="fas fa-sign-in-alt mr-2"></i> Login
            </button>
        </div>

        <!-- Dashboard (Initially Hidden) -->
        <div id="dashboardContainer" class="hidden">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
                <div>
                    <h1 class="text-2xl font-bold text-gray-800">Moderator Dashboard</h1>
                    <p class="text-gray-500">Manage users and moderate content</p>
                </div>
                <div class="flex flex-wrap gap-3">
                    <div class="relative">
                        <select id="statusFilter"
                            class="appearance-none bg-white border border-gray-300 rounded-lg px-4 py-2 pr-8 focus:outline-none focus:ring-2 focus:ring-primary-500 transition-all">
                            <option value="all">All Status</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                            <option value="reported">Reported</option>
                        </select>
                        <div
                            class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stats Cards -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                <div class="bg-white rounded-xl shadow-soft p-6 card-hover border border-gray-100">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm">Total Users</p>
                            <h3 class="text-2xl font-bold text-gray-800" id="userCount">0</h3>
                            <p class="text-xs text-green-500 mt-1"><i class="fas fa-arrow-up mr-1"></i> 5% from last
                                week</p>
                        </div>
                        <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-users text-blue-500 text-xl"></i>
                        </div>
                    </div>
                </div>
                <div class="bg-white rounded-xl shadow-soft p-6 card-hover border border-gray-100">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm">Active Users</p>
                            <h3 class="text-2xl font-bold text-gray-800" id="activeCount">0</h3>
                            <p class="text-xs text-gray-500 mt-1">Currently active accounts</p>
                        </div>
                        <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-user-check text-green-500 text-xl"></i>
                        </div>
                    </div>
                </div>
                <div class="bg-white rounded-xl shadow-soft p-6 card-hover border border-gray-100">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm">Reported Content</p>
                            <h3 class="text-2xl font-bold text-gray-800" id="reportCount">0</h3>
                            <p class="text-xs text-gray-500 mt-1">Pending review</p>
                        </div>
                        <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-flag text-yellow-500 text-xl"></i>
                        </div>
                    </div>
                </div>
                <div class="bg-white rounded-xl shadow-soft p-6 card-hover border border-gray-100">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm">Warnings Issued</p>
                            <h3 class="text-2xl font-bold text-gray-800" id="warningCount">0</h3>
                            <p class="text-xs text-gray-500 mt-1">Last 30 days</p>
                        </div>
                        <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-exclamation-triangle text-red-500 text-xl"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- User Management Tabs -->
            <div class="bg-white rounded-xl shadow-soft overflow-hidden border border-gray-100 mb-8">
                <div class="border-b border-gray-200">
                    <div class="flex overflow-x-auto">
                        <button id="allUsersTab"
                            class="px-6 py-4 text-primary-600 border-b-2 border-primary-500 font-medium">
                            All Users
                        </button>
                        <button id="reportedTab" class="px-6 py-4 text-gray-500 hover:text-gray-700 font-medium">
                            Reported Users
                        </button>
                        <button id="warnedTab" class="px-6 py-4 text-gray-500 hover:text-gray-700 font-medium">
                            Warned Users
                        </button>
                    </div>
                </div>

                <!-- User Table -->
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    ID</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Name</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Email</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Status</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Last Active</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Reports</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Actions</th>
                            </tr>
                        </thead>
                        <tbody id="userTableBody" class="bg-white divide-y divide-gray-200">
                            <!-- Table rows will be populated by JavaScript -->
                        </tbody>
                    </table>
                </div>
                <div id="noResults" class="hidden p-6 text-center">
                    <div class="inline-block p-3 rounded-full bg-gray-100 text-gray-500 mb-4">
                        <i class="fas fa-search text-2xl"></i>
                    </div>
                    <p class="text-gray-500">No users found matching your search criteria.</p>
                </div>
                <div class="p-4 border-t border-gray-200 flex flex-col sm:flex-row justify-between items-center gap-4">
                    <div class="text-sm text-gray-500">
                        Showing <span id="showingCount" class="font-medium">0</span> of <span id="totalCount"
                            class="font-medium">0</span> users
                    </div>
                    <div class="flex items-center space-x-4">
                        <div class="flex items-center space-x-1">
                            <button id="prevPage"
                                class="px-3 py-1 border border-gray-300 rounded-md disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-50 transition-colors">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <div class="text-sm text-gray-700">Page <span id="currentPageNum">1</span></div>
                            <button id="nextPage"
                                class="px-3 py-1 border border-gray-300 rounded-md disabled:opacity-50 disabled:cursor-not-allowed hover:bg-gray-50 transition-colors">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                        <select id="pageSizeSelect"
                            class="appearance-none bg-white border border-gray-300 rounded-lg px-3 py-1 pr-8 focus:outline-none focus:ring-2 focus:ring-primary-500 text-sm">
                            <option value="5">5 per page</option>
                            <option value="10">10 per page</option>
                            <option value="20">20 per page</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Reports Section -->
            <div class="bg-white rounded-xl shadow-soft overflow-hidden border border-gray-100 mb-8">
                <div class="p-6 border-b border-gray-200">
                    <h2 class="text-xl font-bold text-gray-800">Recent Reports</h2>
                    <p class="text-gray-500">Review and take action on reported content</p>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Report ID</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    User</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Content Type</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Reason</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Date</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Status</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                    Actions</th>
                            </tr>
                        </thead>
                        <tbody id="reportTableBody" class="bg-white divide-y divide-gray-200">
                            <!-- Table rows will be populated by JavaScript -->
                        </tbody>
                    </table>
                </div>
                <div id="noReports" class="hidden p-6 text-center">
                    <div class="inline-block p-3 rounded-full bg-green-100 text-green-500 mb-4">
                        <i class="fas fa-check text-2xl"></i>
                    </div>
                    <p class="text-gray-500">No pending reports to review. Great job!</p>
                </div>
            </div>
        </div>
    </main>

    <!-- View User Modal -->
    <div id="viewUserModal"
        class="hidden fixed inset-0 flex items-center justify-center bg-gray-900 bg-opacity-50 z-50">
        <div class="bg-white p-6 rounded-xl max-w-md w-full shadow-xl">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-xl font-semibold text-gray-800">User Details</h3>
                <button id="closeViewModal" class="text-gray-500 hover:text-gray-700 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12">
                        </path>
                    </svg>
                </button>
            </div>
            <div class="space-y-4">
                <div class="flex items-center justify-center mb-4">
                    <div class="w-20 h-20 rounded-full bg-gray-200 flex items-center justify-center">
                        <i id="userAvatar" class="fas fa-user text-gray-400 text-3xl"></i>
                    </div>
                </div>
                <div>
                    <p class="text-sm text-gray-500">User ID</p>
                    <p id="viewUserId" class="font-medium">-</p>
                </div>
                <div>
                    <p class="text-sm text-gray-500">Name</p>
                    <p id="viewName" class="font-medium">-</p>
                </div>
                <div>
                    <p class="text-sm text-gray-500">Email</p>
                    <p id="viewEmail" class="font-medium">-</p>
                </div>
                <div>
                    <p class="text-sm text-gray-500">Status</p>
                    <p id="viewStatus" class="font-medium">-</p>
                </div>
                <div>
                    <p class="text-sm text-gray-500">Reports</p>
                    <p id="viewReports" class="font-medium">-</p>
                </div>
                <div>
                    <p class="text-sm text-gray-500">Last Active</p>
                    <p id="viewLastActive" class="font-medium">-</p>
                </div>
                <div>
                    <p class="text-sm text-gray-500">Account Created</p>
                    <p id="viewCreated" class="font-medium">-</p>
                </div>
            </div>
            <div class="mt-6 flex justify-end space-x-4">
                <button id="closeViewBtn"
                    class="px-4 py-2 border border-gray-300 rounded-md hover:bg-gray-100 transition-colors">Close</button>
                <button id="warnUserBtn"
                    class="px-4 py-2 bg-yellow-500 text-white rounded-md hover:bg-yellow-600 transition-colors">Issue
                    Warning</button>
            </div>
        </div>
    </div>

    <!-- View Report Modal -->
    <div id="viewReportModal"
        class="hidden fixed inset-0 flex items-center justify-center bg-gray-900 bg-opacity-50 z-50">
        <div class="bg-white p-6 rounded-xl max-w-lg w-full shadow-xl">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-xl font-semibold text-gray-800">Report Details</h3>
                <button id="closeReportModal" class="text-gray-500 hover:text-gray-700 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12">
                        </path>
                    </svg>
                </button>
            </div>
