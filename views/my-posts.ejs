<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Posts - Social</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
  <link rel="icon" type="image/x-icon" href="/images/icon.png">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          animation: {
            'fade-in': 'fadeIn 0.4s ease-out',
          },
          keyframes: {
            fadeIn: {
              '0%': { opacity: '0', transform: 'translateY(12px)' },
              '100%': { opacity: '1', transform: 'translateY(0)' }
            }
          },
          colors: {
            'primary-blue': '#1e40af',
            'light-blue': '#60a5fa',
            'soft-white': '#f8fafc',
          }
        }
      }
    }
  </script>
  <style>
    body {
      background: #e0f2fe;
    }

    .post-card {
      transition: transform 0.3s, box-shadow 0.3s;
      border-left: 4px solid #1e40af;
    }

    .post-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 20px rgba(30, 64, 175, 0.15);
    }

    .nav {
      background: linear-gradient(to right, #1e40af, #3b82f6);
    }

    .create-post-btn {
      transition: background 0.3s, transform 0.3s;
    }

    .create-post-btn:hover {
      background: #dbeafe;
      transform: scale(1.02);
    }

    .loading-spinner {
      border: 4px solid #60a5fa;
      border-top-color: transparent;
    }

    .profile-image {
      transition: opacity 0.3s ease;
      backface-visibility: hidden;
    }

    .profile-image.loading {
      opacity: 0.6;
    }

    .post-card img,
    .post-card video {
      opacity: 1;
      transition: opacity 0.3s ease;
    }

    .post-card img[loading],
    .post-card video[loading] {
      opacity: 0.6;
    }
  </style>
</head>

<body class="bg-gray-50">
  <script>
    window.__USER_DATA__ = <% - JSON.stringify(user || null) %>;
  </script>

  <nav class="nav shadow-md fixed w-full top-0 z-50 text-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex justify-between h-16">
        <div class="flex items-center">
          <h1 class="text-2xl font-bold">Your Posts</h1>
        </div>
        <a href="/"
          class="flex items-center px-4 py-2 my-auto border rounded-md text-white bg-primary-blue hover:bg-light-blue">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Home
        </a>
      </div>
    </div>
  </nav>

  <main class="pt-20 pb-10 px-4 max-w-7xl mx-auto">
    <div class="bg-soft-white dark:bg-gray-800 rounded-xl shadow-lg p-6 mb-6 create-post-btn">
      <div class="flex items-center space-x-4">
        <img id="userProfilePic" src="<%= user && user.profilePhoto ? user.profilePhoto : '' %>" alt="Profile Picture"
          class="w-10 h-10 rounded-full object-cover profile-image border-2 border-light-blue" loading="lazy">
        <button id="create-post-button"
          class="flex-grow text-left px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400 rounded-full hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
          What's on your mind, <span id="userName">
            <%- user && user.name ? user.name : 'Guest' %>
          </span>?
        </button>
      </div>
    </div>
    <div id="post-feed" class="space-y-6"></div>
    <div id="no-posts" class="hidden text-center py-10">
      <p class="text-xl text-gray-600 dark:text-gray-400">Your posts will appear here!</p>
      <p class="text-sm text-gray-500 dark:text-gray-500 mt-2">Start sharing your thoughts, <span id="noPostsUserName">
          <%- user && user.name ? user.name : 'Guest' %>
        </span>!</p>
    </div>
    <div id="loading-indicator" class="flex flex-col items-center justify-center py-10 space-y-4">
      <div class="loading-spinner w-10 h-10 rounded-full animate-spin"></div>
      <p class="text-sm text-primary-blue">Loading your posts...</p>
    </div>
    <div id="error-state" class="hidden text-center py-10">
      <div class="text-red-500 dark:text-red-400 mb-4">
        <svg class="w-14 h-14 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <p class="text-gray-600 dark:text-gray-300 mb-6" id="error-message">Failed to load your posts</p>
      <button id="retry-button"
        class="px-5 py-2 bg-primary-blue text-white rounded-lg hover:bg-light-blue transition-colors">
        Try Again
      </button>
    </div>
  </main>

  <div id="create-post-modal" class="hidden fixed inset-0 bg-black/50 z-50">
    <div
      class="bg-soft-white dark:bg-gray-800 rounded-xl shadow-lg p-6 max-w-lg w-full mx-4 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-bold text-primary-blue dark:text-white">Create a Post</h3>
        <button id="close-modal" class="text-gray-500 hover:text-gray-700 dark:hover:text-gray-300">×</button>
      </div>
      <form id="createPostForm" action="/api/posts" method="POST" enctype="multipart/form-data">
        <textarea id="postContent" name="content" rows="4" required
          class="w-full p-3 border border-gray-300 dark:border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-light-blue dark:bg-gray-700 dark:text-white"
          placeholder="What's on your mind, <%- user && user.name ? user.name : 'Guest' %>?"></textarea>
        <div class="mt-4">
          <label for="fileUpload" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Upload a
            File</label>
          <input type="file" id="fileUpload" name="fileUpload" accept="image/*,video/mp4"
            class="mt-2 w-full text-sm text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-gray-700 rounded-lg">
        </div>
        <div class="mt-4">
          <label for="linkInput" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Add a Link</label>
          <input type="url" id="linkInput" name="linkInput"
            class="mt-2 w-full p-3 border border-gray-300 dark:border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-light-blue dark:bg-gray-700 dark:text-white"
            placeholder="https://example.com">
        </div>
        <div class="mt-4 flex justify-end space-x-4">
          <button type="button" id="cancelPostButton"
            class="text-gray-600 hover:text-gray-800 dark:hover:text-gray-200">Cancel</button>
          <button type="submit" id="postButton"
            class="px-4 py-2 bg-primary-blue text-white rounded-lg hover:bg-light-blue">Post</button>
        </div>
      </form>
    </div>
  </div>

  <div id="edit-post-modal" class="hidden fixed inset-0 bg-black/50 z-50">
    <div
      class="bg-soft-white dark:bg-gray-800 rounded-xl shadow-lg p-6 max-w-lg w-full mx-4 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-bold text-primary-blue dark:text-white">Edit Post</h3>
        <button id="close-edit-modal" class="text-gray-500 hover:text-gray-700 dark:hover:text-gray-300">×</button>
      </div>
      <form id="editPostForm">
        <input type="hidden" id="editPostId" name="postId">
        <textarea id="editPostContent" name="content" rows="4" required
          class="w-full p-3 border border-gray-300 dark:border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-light-blue dark:bg-gray-700 dark:text-white"
          placeholder="What's on your mind?"></textarea>
        <div class="mt-4">
          <label for="editLinkInput" class="block text-sm font-medium text-gray-700 dark:text-gray-300">Edit
            Link</label>
          <input type="url" id="editLinkInput" name="linkInput"
            class="mt-2 w-full p-3 border border-gray-300 dark:border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-light-blue dark:bg-gray-700 dark:text-white"
            placeholder="https://example.com">
        </div>
        <div class="mt-4 flex justify-end space-x-4">
          <button type="button" id="cancelEditButton"
            class="text-gray-600 hover:text-gray-800 dark:hover:text-gray-200">Cancel</button>
          <button type="submit" id="saveEditButton"
            class="px-4 py-2 bg-primary-blue text-white rounded-lg hover:bg-light-blue">Save</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      const getDefaultAvatar = () => {
        return 'data:image/svg+xml;base64,' + btoa(`
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#60a5fa">
            <circle cx="12" cy="12" r="12"/>
            <path fill="#fff" d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
          </svg>
        `);
      };

      const formatTimestamp = (date) => {
        if (!date || isNaN(new Date(date))) return 'Unknown date';
        const now = new Date();
        const seconds = Math.floor((now - new Date(date)) / 1000);
        if (seconds < 60) return `${seconds} second${seconds === 1 ? '' : 's'} ago`;
        const minutes = Math.floor(seconds / 60);
        if (minutes < 60) return `${minutes} minute${minutes === 1 ? '' : 's'} ago`;
        const hours = Math.floor(minutes / 60);
        if (hours < 24) return `${hours} hour${hours === 1 ? '' : 's'} ago`;
        const days = Math.floor(hours / 24);
        if (days < 30) return `${days} day${days === 1 ? '' : 's'} ago`;
        return new Date(date).toLocaleString();
      };

      const updateUserInterface = (user) => {
        const profilePic = document.getElementById('userProfilePic');
        const userName = document.getElementById('userName');
        const noPostsUserName = document.getElementById('noPostsUserName');

        if (profilePic) {
          profilePic.classList.add('loading');
          const photoUrl = user.profilePhoto ? `${user.profilePhoto}?t=${Date.now()}` : getDefaultAvatar();
          profilePic.src = photoUrl;
          profilePic.onload = () => profilePic.classList.remove('loading');
          profilePic.onerror = () => {
            profilePic.src = getDefaultAvatar();
            profilePic.classList.remove('loading');
          };
        }

        const name = user.name || 'Guest';
        if (userName) userName.textContent = name;
        if (noPostsUserName) noPostsUserName.textContent = name;
      };

      const fetchUserData = async (retries = 2) => {
        try {
          const response = await fetch('/api/me', {
            method: 'GET',
            credentials: 'include'
          });

          if (response.ok) {
            const data = await response.json();
            if (data.user) {
              updateUserInterface(data.user);
              return data.user;
            }
          }
          throw new Error('Failed to fetch user data');
        } catch (error) {
          console.warn('Fetch user error:', error);
          if (retries > 0) {
            await new Promise(r => setTimeout(r, 1000));
            return fetchUserData(retries - 1);
          }
          return window.__USER_DATA__ || {};
        }
      };

      const renderMediaContent = (fileUrl) => {
        if (!fileUrl) return '';
        return fileUrl.match(/\.(mp4|webm)$/i)
          ? `<video controls class="w-full max-h-96 rounded-lg mb-4 border border-light-blue" loading="lazy">
              <source src="${fileUrl}" type="video/mp4">
              Your browser does not support video playback.
            </video>`
          : `<img src="${fileUrl}" alt="Post Media" 
              class="w-full max-h-96 object-cover rounded-lg mb-4 border border-light-blue" 
              onerror="this.src='${getDefaultAvatar()}'" 
              loading="lazy">`;
      };

      const renderPost = (post) => {
        const postElement = document.createElement('div');
        postElement.className = 'post-card bg-soft-white dark:bg-gray-800 rounded-xl p-6 animate-fade-in';

        const userPhotoUrl = post.userId.profilePhoto ? `${post.userId.profilePhoto}?t=${Date.now()}` : getDefaultAvatar();
        const createdAt = formatTimestamp(post.createdAt);

        postElement.innerHTML = `
          <div class="flex items-center space-x-4 mb-4">
            <img src="${userPhotoUrl}" alt="Profile" 
              class="w-12 h-12 rounded-full object-cover border-2 border-light-blue"
              onerror="this.src='${getDefaultAvatar()}'"
              loading="lazy">
            <div>
              <h3 class="text-base font-semibold text-primary-blue dark:text-white">
                ${post.userId.name || 'Anonymous'}
              </h3>
              <p class="text-xs text-gray-500 dark:text-gray-400">
                ${createdAt}
              </p>
            </div>
          </div>
          <p class="text-gray-700 dark:text-gray-200 mb-4 whitespace-pre-wrap">
            ${post.content || ''}
          </p>
          ${post.file ? renderMediaContent(post.file) : ''}
          ${post.link ? `
            <a href="${post.link}" target="_blank" rel="noopener noreferrer" 
               class="text-light-blue hover:underline block mb-4">
              ${post.link}
            </a>
          ` : ''}
          <div class="flex justify-end space-x-2">
            <button class="edit-post-btn text-primary-blue hover:text-light-blue" data-id="${post._id}"
              data-content="${encodeURIComponent(post.content || '')}" 
              data-link="${encodeURIComponent(post.link || '')}">
              <i class="fas fa-edit"></i> Edit
            </button>
            <button class="delete-post-btn text-red-500 hover:text-red-600" data-id="${post._id}">
              <i class="fas fa-trash"></i> Delete
            </button>
          </div>
        `;
        return postElement;
      };

      const fetchPosts = async () => {
        const postFeed = document.getElementById('post-feed');
        const noPosts = document.getElementById('no-posts');
        const loadingIndicator = document.getElementById('loading-indicator');
        const errorState = document.getElementById('error-state');

        try {
          loadingIndicator.classList.remove('hidden');
          postFeed.innerHTML = '';
          noPosts.classList.add('hidden');
          errorState.classList.add('hidden');

          const response = await fetch('/api/my-posts', {
            method: 'GET',
            credentials: 'include'
          });

          if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.message || 'Failed to fetch posts');
          }

          const posts = await response.json();
          postFeed.innerHTML = '';

          if (posts.length === 0) {
            noPosts.classList.remove('hidden');
            return;
          }

          posts.forEach(post => postFeed.appendChild(renderPost(post)));
        } catch (error) {
          console.error('Fetch posts error:', error);
          errorState.classList.remove('hidden');
          document.getElementById('error-message').textContent = error.message || 'Failed to load your posts';
        } finally {
          loadingIndicator.classList.add('hidden');
        }
      };

      const toggleModal = (modalId, show) => {
        const modal = document.getElementById(modalId);
        modal.classList.toggle('hidden', !show);
      };

      const handleCreatePost = async (event) => {
        event.preventDefault();
        const formData = new FormData(event.target);
        formData.append('createdAt', new Date().toISOString());
        const postButton = document.getElementById('postButton');

        try {
          postButton.disabled = true;
          const response = await fetch('/api/posts', {
            method: 'POST',
            body: formData,
            credentials: 'include'
          });

          if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.message || 'Failed to create post');
          }

          toggleModal('create-post-modal', false);
          event.target.reset();
          await fetchPosts();
        } catch (error) {
          alert(error.message || 'Failed to create post');
        } finally {
          postButton.disabled = false;
        }
      };

      const handleEditPost = async (event) => {
        event.preventDefault();
        const postId = document.getElementById('editPostId').value;
        const content = document.getElementById('editPostContent').value;
        const link = document.getElementById('editLinkInput').value;
        const saveButton = document.getElementById('saveEditButton');

        try {
          saveButton.disabled = true;
          const response = await fetch('/api/posts', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: postId, content, link }),
            credentials: 'include'
          });

          if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.message || 'Failed to update post');
          }

          toggleModal('edit-post-modal', false);
          await fetchPosts();
        } catch (error) {
          alert(error.message || 'Failed to update post');
        } finally {
          saveButton.disabled = false;
        }
      };

      const handleDeletePost = async (postId) => {
        if (!confirm('Are you sure you want to delete this post?')) return;

        try {
          const response = await fetch('/api/posts', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: postId }),
            credentials: 'include'
          });

          if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.message || 'Failed to delete post');
          }

          await fetchPosts();
        } catch (error) {
          alert(error.message || 'Failed to delete post');
        }
      };

      // Initialize
      const user = await fetchUserData();
      await fetchPosts();

      // Event listeners
      document.getElementById('create-post-button').addEventListener('click', () => toggleModal('create-post-modal', true));
      document.getElementById('close-modal').addEventListener('click', () => toggleModal('create-post-modal', false));
      document.getElementById('cancelPostButton').addEventListener('click', () => toggleModal('create-post-modal', false));
      document.getElementById('createPostForm').addEventListener('submit', handleCreatePost);

      document.getElementById('close-edit-modal').addEventListener('click', () => toggleModal('edit-post-modal', false));
      document.getElementById('cancelEditButton').addEventListener('click', () => toggleModal('edit-post-modal', false));
      document.getElementById('editPostForm').addEventListener('submit', handleEditPost);

      document.getElementById('retry-button').addEventListener('click', async () => {
        document.getElementById('error-state').classList.add('hidden');
        await fetchPosts();
      });

      document.getElementById('post-feed').addEventListener('click', (e) => {
        if (e.target.closest('.edit-post-btn')) {
          const btn = e.target.closest('.edit-post-btn');
          document.getElementById('editPostId').value = btn.dataset.id;
          document.getElementById('editPostContent').value = decodeURIComponent(btn.dataset.content);
          document.getElementById('editLinkInput').value = decodeURIComponent(btn.dataset.link);
          toggleModal('edit-post-modal', true);
        } else if (e.target.closest('.delete-post-btn')) {
          handleDeletePost(e.target.closest('.delete-post-btn').dataset.id);
        }
      });

      // Close modals on outside click
      document.addEventListener('click', (e) => {
        if (e.target.id === 'create-post-modal') toggleModal('create-post-modal', false);
        if (e.target.id === 'edit-post-modal') toggleModal('edit-post-modal', false);
      });
    });
  </script>
</body>

</html>